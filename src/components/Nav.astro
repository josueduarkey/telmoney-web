---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { ctaFor } from '../config';
import { LANG_LABEL, homeOf, langOf } from '../i18n';

const lang = langOf(Astro.currentLocale);
const other = lang === 'es' ? 'en' : 'es';
const CTA = ctaFor(lang);
const t = {
  es: {
    links: ['Antes y después', 'Cómo funciona', 'Qué hace', 'Planes', 'Preguntas'],
    home: 'TelMoney, inicio',
    main: 'Principal',
    login: 'Entrar',
    loginLong: 'Entrar a mi cuenta',
    open: 'Abrir menú',
    close: 'Cerrar menú',
    switchTo: 'Ver en inglés',
  },
  en: {
    links: ['Before & after', 'How it works', 'Features', 'Pricing', 'FAQ'],
    home: 'TelMoney, home',
    main: 'Main',
    login: 'Sign in',
    loginLong: 'Sign in to my account',
    open: 'Open menu',
    close: 'Close menu',
    switchTo: 'Ver en español',
  },
}[lang];
const links = ['#antes-y-despues', '#como-funciona', '#funciones', '#planes', '#preguntas'].map((href, i) => ({
  href,
  label: t.links[i],
}));
---

<header class="nav" data-nav>
  <div class="nav__inner container">
    <a href="#top" class="nav__brand" aria-label={t.home}>
      <Logo />
    </a>
    <nav class="nav__links" aria-label={t.main}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="nav__lang" href={homeOf(other)} hreflang={other} lang={other} data-lang-switch={other} title={t.switchTo}
      >{LANG_LABEL[other].short}</a
    >
    <ThemeToggle />
    <a class="nav__login" href="/entrar" rel="nofollow">{t.login}</a>
    <a
      class="btn nav__cta"
      href={CTA.href}
      data-cursor={CTA.cursor}
      {...CTA.external ? { target: '_blank', rel: 'noopener' } : {}}>{CTA.label}</a
    >
    <button class="nav__toggle" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="sr-only" data-open={t.open} data-close={t.close}>{t.open}</span>
      <i></i><i></i>
    </button>
  </div>
  <div class="nav__menu" id="nav-menu" hidden data-nav-menu>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="/entrar" rel="nofollow">{t.loginLong}</a>
    <a href={homeOf(other)} hreflang={other} lang={other} data-lang-switch={other}>{LANG_LABEL[other].name}</a>
    <a class="btn btn--block" href={CTA.href}>{CTA.label}</a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const menu = nav.querySelector<HTMLElement>('[data-nav-menu]')!;

  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    const sr = toggle.querySelector<HTMLElement>('.sr-only')!;
    sr.textContent = (open ? sr.dataset.close : sr.dataset.open) ?? '';
    menu.hidden = !open;
    nav.classList.toggle('is-open', open);
  };
  toggle.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  // Elegir idioma lo recuerda: "/" ya no redirige según el navegador (Base.astro).
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('tm-lang', a.dataset.langSwitch!);
      } catch {}
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background-color 0.4s,
      box-shadow 0.4s;
  }
  .nav.is-scrolled,
  .nav.is-open {
    background: var(--nav-bg);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 1px 0 var(--hairline);
  }
  /* Menú abierto (celular): fondo sólido, sin transparencia, y una sombra que lo separa de la página. */
  .nav.is-open {
    background: var(--bg);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow:
      0 1px 0 var(--hairline),
      0 24px 48px -12px rgba(0, 0, 0, 0.45);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    height: 72px;
  }
  .nav__brand {
    text-decoration: none;
    margin-right: auto;
  }
  .nav__links {
    display: flex;
    gap: var(--s-6);
  }
  .nav__links a {
    position: relative;
    padding-block: 12px; /* área táctil cómoda en tabletas */
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 1px;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }
  .nav__links a:hover {
    color: var(--text);
  }
  .nav__links a:hover::after {
    transform: scaleX(1);
  }
  .nav__cta {
    min-height: 42px;
    padding: 10px 18px;
  }
  .nav__login {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding: 8px 4px;
    white-space: nowrap;
  }
  .nav__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 34px;
    padding: 0 10px;
    border-radius: var(--r-full);
    box-shadow: inset 0 0 0 1px var(--hairline-strong);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s, box-shadow 0.2s;
  }
  .nav__lang:hover {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--text-muted);
  }
  .nav__login:hover {
    color: var(--text);
  }
  .nav__toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--r-md);
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--hairline-strong);
    cursor: pointer;
  }
  .nav__toggle i {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 2px;
    background: var(--text);
    transition: transform 0.3s var(--ease-out);
  }
  .nav__toggle i:first-of-type {
    top: 17px;
  }
  .nav__toggle i:last-of-type {
    top: 25px;
  }
  .nav.is-open .nav__toggle i:first-of-type {
    transform: translateY(4px) rotate(45deg);
  }
  .nav.is-open .nav__toggle i:last-of-type {
    transform: translateY(-4px) rotate(-45deg);
  }
  .nav__menu {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-2) var(--gutter) var(--s-5);
  }
  .nav__menu[hidden] {
    display: none;
  }
  .nav__menu a:not(.btn) {
    padding: var(--s-3) 0;
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
  }
  .nav__menu .btn {
    margin-top: var(--s-4);
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__cta,
    .nav__login {
      display: none;
    }
    .nav__toggle {
      display: block;
    }
  }
  @media (min-width: 861px) {
    .nav__menu {
      display: none !important;
    }
  }
</style>
