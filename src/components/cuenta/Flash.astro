---
// El resultado de lo último que se hizo en la página (lo deja lib/cuenta/acciones.ts en una cookie).
import { leerAviso } from '../../lib/cuenta/pagina';

const aviso = leerAviso(Astro.cookies);
---

{aviso?.tipo === 'error' && <p class="flash flash--error" role="alert">{aviso.texto}</p>}
{aviso?.tipo === 'ok' && <p class="flash flash--ok" role="status">{aviso.texto}</p>}
