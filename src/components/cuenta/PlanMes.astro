---
// El plan del mes (GET /me/plan): lo que recibe, menos gastos fijos, apartados y sobres, da lo libre; eso
// entre las semanas del mes es el límite semanal. Al lado, la línea de lo que viene hasta el próximo
// ingreso fijo, que es con lo que el bot calcula el disponible del día.
import type { PlanMes } from '../../lib/admin/bot';
import { date, usd } from '../../lib/admin/format';

interface Props {
  plan: PlanMes;
}
const { plan } = Astro.props;
// Los sobres van por el ciclo de su fuente (no al mes): lo que pesan al mes es lo que falta para cuadrar.
const conDestino = plan.ingresos_mes - plan.fijos_mes - plan.apartados.reduce((s, a) => s + a.monto, 0) - plan.libre_mes;
const restas = [
  { nombre: 'Gastos fijos', monto: plan.fijos_mes },
  ...plan.apartados,
  { nombre: 'Dinero con destino', monto: Math.round(conDestino * 100) / 100 },
].filter((x) => x.monto > 0.004);
---

<div class="grid-2">
  <section class="card" aria-labelledby="t-plan">
    <div class="card__head">
      <div>
        <h2 id="t-plan">Tu plan del mes</h2>
        <p class="card__sub">Con lo que esperas recibir</p>
      </div>
      <a class="card__sub" href="/cuenta/ingresos">Ingresos</a>
    </div>
    <table class="table table--card">
      <tbody>
        <tr>
          <td>Tus ingresos</td>
          <td class="r kind-income">{usd(plan.ingresos_mes)}</td>
        </tr>
        {
          restas.map((x) => (
            <tr>
              <td class="muted">{x.nombre}</td>
              <td class="r">−{usd(x.monto)}</td>
            </tr>
          ))
        }
        <tr class="plan__total">
          <td>Libre para gastar</td>
          <td class="r">{usd(plan.libre_mes)}</td>
        </tr>
      </tbody>
    </table>
    <p class="stat__note">
      {
        plan.libre_mes >= 0 ? (
          <>Unos <b>{usd(plan.semanal)}</b> por semana.</>
        ) : (
          <>Lo que pagas y apartas pasa lo que recibes por <b>{usd(-plan.libre_mes)}</b> al mes: revisa tus gastos fijos o tus apartados.</>
        )
      }
      {plan.sobres.map((s) => <> Para {s.nombre}: te quedan <b>{usd(s.queda)}</b> hasta el {date(s.hasta)}.</>)}
    </p>
  </section>

  <section class="card" aria-labelledby="t-linea">
    <div class="card__head">
      <div>
        <h2 id="t-linea">Lo que viene</h2>
        <p class="card__sub">{plan.horizonte ? `Hasta tu próximo ingreso fijo, el ${date(plan.horizonte)}` : 'Tus próximos movimientos'}</p>
      </div>
    </div>
    {
      plan.linea.length ? (
        <table class="table table--card">
          <tbody>
            {plan.linea.map((x) => (
              <tr>
                <td class="nowrap muted">{date(x.fecha)}</td>
                <td>{x.concepto}</td>
                <td class:list={['r nowrap', { 'kind-income': x.monto > 0 }]}>
                  {x.monto > 0 ? '+' : '−'}
                  {usd(Math.abs(x.monto))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="empty">
          {plan.horizonte ? 'No tienes pagos ni ingresos antes de esa fecha.' : 'Agrega un ingreso fijo y aquí ves lo que recibes y lo que pagas hasta entonces.'}
        </p>
      )
    }
    {
      plan.disponible_hoy !== null && (
        <p class="stat__note">
          Por eso hoy puedes gastar <b>{usd(plan.disponible_hoy)}</b>
          {plan.pendiente_apartados > 0 && <>, sin contar {usd(plan.pendiente_apartados)} que te falta apartar</>}
          {plan.en_sobres > 0 && <>{plan.pendiente_apartados > 0 ? ' ni' : ', sin contar'} {usd(plan.en_sobres)} que tienes con destino</>}.
        </p>
      )
    }
  </section>
</div>

<style>
  .plan__total td {
    font-weight: 700;
    border-top: 1px solid var(--hairline-strong);
  }
</style>
