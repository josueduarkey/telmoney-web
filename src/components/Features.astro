---
import Chat from './Chat.astro';
import { reporte } from '../data/chats';

const questions = [
  '¿En qué se me fue el pisto?',
  '¿Puedo comprar algo de 80?',
  'Compara este mes con el anterior',
  '¿Cuánto me falta para la moto?',
];
const extras = [
  { t: 'Avisos de pagos fijos', d: 'Alquiler, luz, cuotas y tu tarjeta, 2 días antes.', pro: true },
  { t: 'Cobros sin pena', d: 'Un recordatorio amable, listo para mandar.', pro: true },
  { t: 'Ahorro automático', d: 'En cada ingreso te ofrece apartar tu %.' },
  { t: 'Varias cuentas', d: 'Efectivo, bancos, billeteras y tarjetas, al centavo.' },
  { t: 'Metas y límites', d: 'Con fecha, y con aviso cuando te acercas.' },
  { t: 'Excel, PDF y CSV', d: 'Tus movimientos y gráficas cuando los pidas.' },
];
---

<section class="features band" id="funciones">
  <div class="container">
    <header class="features__head">
      <h2 class="display">El amigo ordenado que te ayuda sin regañarte<span class="pd">.</span></h2>
    </header>

    <div class="bento">
      <article class="card card--spot card--report" data-score>
        <span class="pro">Puntaje en Pro</span>
        <div class="card__text">
          <h3 class="h3">Tu noche financiera</h3>
          <p>Cada noche, tu día en un mensaje y un puntaje de 0 a 100 que se entiende.</p>
          <div class="score" role="img" aria-label="Salud financiera: 78 de 100">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="52" class="score__track"></circle>
              <circle cx="60" cy="60" r="52" class="score__fill" pathLength="100" data-score-ring></circle>
            </svg>
            <span class="score__n num"><b data-score-n>78</b><small>/100</small></span>
          </div>
          <p class="card__fine">
            Las cifras las calcula TelMoney. La IA solo redacta el consejo y no puede cambiar un número.
          </p>
        </div>
        <div class="card__chat">
          <Chat messages={reporte} compact />
        </div>
      </article>

      <article class="card card--ask">
        <h3 class="h3">Pregúntale lo que quieras</h3>
        <ul class="asks" role="list">
          {questions.map((q) => <li>{q}</li>)}
        </ul>
      </article>
    </div>

    <ul class="extras" role="list">
      {
        extras.map((e) => (
          <li>
            <h3>
              {e.t}
              {e.pro && <span class="pro pro--inline">Pro</span>}
            </h3>
            <p>{e.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    background: var(--black);
  }
  .features__head {
    max-width: 900px;
    margin-bottom: var(--s-8);
  }

  .bento {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--s-4);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: clamp(22px, 3vw, 36px);
    border-radius: var(--r-xxl);
    background: var(--night);
    box-shadow: inset 0 0 0 1px var(--hairline-dark);
    overflow: hidden;
  }
  .card__text > p {
    color: var(--on-dark-muted);
    line-height: 1.6;
  }
  .pro {
    position: absolute;
    top: 22px;
    right: 22px;
    padding: 3px 10px;
    border-radius: var(--r-full);
    background: rgba(245, 184, 61, 0.14);
    color: var(--gold);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .pro--inline {
    position: static;
    margin-left: 8px;
    vertical-align: 2px;
  }

  .card--report {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s-6);
    align-items: center;
  }
  .card--spot {
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(14, 159, 110, 0.3), transparent 60%),
      var(--vault);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .card--report .h3 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: var(--s-4);
  }
  .card--report .card__chat {
    padding: var(--s-4);
    border-radius: var(--r-xl);
    background: var(--chat-bg) url("/whatsapp-fondo.png") center / cover;
  }
  .card__fine {
    margin-top: var(--s-5);
    font-size: var(--fs-small);
    color: var(--on-dark-faint) !important;
  }

  .score {
    position: relative;
    width: 156px;
    height: 156px;
    margin-top: var(--s-6);
  }
  .score svg {
    width: 100%;
    height: 100%;
    rotate: -90deg;
  }
  .score circle {
    fill: none;
    stroke-width: 9;
  }
  .score__track {
    stroke: rgba(255, 255, 255, 0.1);
  }
  .score__fill {
    stroke: var(--green-glow);
    stroke-linecap: round;
    stroke-dasharray: 78 100;
  }
  .score__n {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    font-family: var(--font-ui);
    line-height: 1;
  }
  .score__n b {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .score__n small {
    font-size: 0.85rem;
    color: var(--on-dark-faint);
    font-weight: 600;
  }

  .card--ask {
    background: var(--white);
    color: var(--ink);
    box-shadow: none;
  }
  .asks {
    list-style: none;
    margin: auto 0 0;
    padding: var(--s-5) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .asks li {
    align-self: flex-end;
    max-width: 92%;
    padding: 9px 14px;
    border-radius: 14px 14px 4px 14px;
    background: var(--black);
    color: var(--white);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .asks li:nth-child(even) {
    align-self: flex-start;
    border-radius: 14px 14px 14px 4px;
    background: var(--cloud);
    color: var(--ink);
  }

  .extras {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }
  .extras li {
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline-dark-strong);
  }
  .extras h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--s-2);
  }
  .extras p {
    color: var(--on-dark-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 991px) {
    .bento,
    .card--report {
      grid-template-columns: 1fr;
    }
    .extras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 575px) {
    .extras {
      grid-template-columns: 1fr;
    }
  }
</style>
