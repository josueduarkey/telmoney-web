---
// Logo oficial de TelMoney: el pájaro que forma una «t» (public/favicon.png).
// Se usa la versión recortada public/app-icon.png («npm run icons» la regenera).
// El dibujo tiene partes casi negras y fondo transparente: va sobre una baldosa blanca
// para verse igual sobre fondos claros y oscuros.
// Al lado, «tel money» en Plus Jakarta Sans: «tel» en peso medio (color del texto) y
// «money» en negrita verde.
interface Props {
  size?: number;
  wordmark?: boolean;
  /** Recorte circular (foto de perfil del chat) en vez de baldosa redondeada */
  round?: boolean;
  class?: string;
}
const { size = 32, wordmark = true, round = false, class: cls = '' } = Astro.props;
---

<span class:list={['logo', cls]}>
  <span class:list={['logo__mark', { 'logo__mark--round': round }]} style={`--size:${size}px`}>
    <img src="/app-icon.png" alt="" width={size} height={size} decoding="async" />
  </span>
  {
    wordmark && (
      <span class="logo__word">
        <span class="logo__tel">tel</span>
        <b>money</b>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 26%;
    background: #ffffff;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }
  .logo__mark--round {
    border-radius: 50%;
  }
  .logo__mark img {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }
  .logo__word {
    display: inline-flex;
    font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .logo__tel {
    font-weight: 500;
    color: var(--logo-tel, currentColor);
  }
  .logo__word b {
    font-weight: 800;
    color: var(--logo-money);
  }
</style>
