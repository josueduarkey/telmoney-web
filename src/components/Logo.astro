---
// Logo oficial de TelMoney: la "t" con una burbuja de chat que sonríe (public/logo-mark.svg).
// El símbolo es blanco y va sobre una baldosa verde: se ve igual sobre fondos claros y oscuros.
// Al lado, "tel money" en Plus Jakarta Sans: "tel" en peso medio (color del texto) y
// "money" en negrita verde.
interface Props {
  size?: number;
  wordmark?: boolean;
  /** Recorte circular (foto de perfil del chat) en vez de baldosa redondeada */
  round?: boolean;
  class?: string;
}
const { size = 32, wordmark = true, round = false, class: cls = '' } = Astro.props;
---

<span class:list={['logo', cls]}>
  <span class:list={['logo__mark', { 'logo__mark--round': round }]} style={`--size:${size}px`}>
    <img src="/logo-mark.svg" alt="" width={size} height={size} decoding="async" />
  </span>
  {
    wordmark && (
      <span class="logo__word">
        <span class="logo__tel">tel</span>
        <b>money</b>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 26%;
    background: #0e9f6e;
    overflow: hidden;
  }
  .logo__mark--round {
    border-radius: 50%;
  }
  .logo__mark img {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }
  .logo__word {
    display: inline-flex;
    font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.3rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .logo__tel {
    font-weight: 500;
    color: var(--logo-tel, currentColor);
  }
  .logo__word b {
    font-weight: 800;
    color: var(--logo-money);
  }
</style>
