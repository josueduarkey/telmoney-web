---
// Botón de modo claro / oscuro.
// - Primera visita: sigue la configuración del navegador (prefers-color-scheme), aplicada en
//   <head> por Base.astro antes de pintar, así no hay parpadeo.
// - Al tocarlo: cambia el tema y lo recuerda en localStorage. Si la elección coincide con la del
//   sistema, se borra lo guardado y la página vuelve a seguir al sistema.
// - La transición: el tema nuevo entra como un círculo de borde difuminado que crece desde el botón
//   (View Transitions) y un brillo verde tenue se disuelve detrás. Sin animación si la persona pidió
//   menos movimiento; si el navegador no soporta View Transitions, queda solo el brillo.
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar a modo claro">
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
    </g>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8a8.4 8.4 0 1 0 10.8 10.8Z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const KEY = 'tm-theme';
  const root = document.documentElement;
  const system = window.matchMedia('(prefers-color-scheme: light)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  const systemTheme = () => (system.matches ? 'light' : 'dark');
  const current = () => (root.dataset.theme === 'light' ? 'light' : 'dark');

  const sync = () => {
    const t = current();
    const next = t === 'dark' ? 'claro' : 'oscuro';
    buttons.forEach((b) => {
      b.setAttribute('aria-label', `Cambiar a modo ${next}`);
      b.title = `Modo ${next}`;
      b.dataset.cursor = `Modo ${next}`;
    });
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'light' ? '#ffffff' : '#000000');
  };

  // «theme-switching» apaga las transiciones de color de los componentes (si no, un botón pasaría
  // unos milisegundos con texto y fondo del mismo color) y esconde la etiqueta del cursor, que si no
  // quedaría congelada en la «foto» que toma el navegador para animar el cambio.
  const startSwitch = () => root.classList.add('theme-switching');
  const endSwitch = () => root.classList.remove('theme-switching');

  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    sync();
  };

  const save = (theme: 'light' | 'dark') => {
    try {
      if (theme === systemTheme()) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, theme);
    } catch {
      /* sin almacenamiento (modo privado): el cambio vale solo para esta visita */
    }
  };

  // Aura: un brillo verde muy tenue que nace en el botón y se disuelve (sin anillo)
  const aura = (x: number, y: number) => {
    const el = document.createElement('span');
    el.className = 'theme-aura';
    el.setAttribute('aria-hidden', 'true');
    el.style.left = `${x}px`;
    el.style.top = `${y}px`;
    document.body.appendChild(el);
    el.addEventListener('animationend', () => el.remove());
  };

  type ViewTransition = { ready: Promise<void>; finished: Promise<void> };
  const doc = document as Document & { startViewTransition?: (cb: () => void) => ViewTransition };

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      save(next);
      const r = button.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;

      if (reduced.matches || !doc.startViewTransition) {
        startSwitch();
        apply(next);
        if (!reduced.matches) aura(x, y);
        requestAnimationFrame(() => requestAnimationFrame(endSwitch));
        return;
      }

      // Antes de la «foto»: se esconde la etiqueta del cursor
      startSwitch();
      // El tema nuevo entra como un círculo de borde difuminado que crece desde el botón.
      // La máscara es un degradado radial: sólido hasta el 70 % del radio y se desvanece hasta el 100 %.
      const reach = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      const size = Math.ceil((reach * 2) / 0.7);
      const vt = doc.startViewTransition(() => {
        apply(next);
        aura(x, y); // el aura vive en la página nueva, no en la foto de la vieja
      });
      vt.ready.then(() => {
        root.animate(
          {
            maskSize: ['0px 0px', `${size}px ${size}px`],
            maskPosition: [`${x}px ${y}px`, `${x - size / 2}px ${y - size / 2}px`],
          },
          {
            // Arranca rápido y frena suave: la página vieja (que es una foto quieta) desaparece pronto
            duration: 700,
            easing: 'cubic-bezier(0.33, 1, 0.68, 1)',
            fill: 'both',
            pseudoElement: '::view-transition-new(root)',
          },
        );
      });
      // El estilo se recalcula una sola vez más, al terminar (no a mitad de la animación)
      vt.finished.finally(endSwitch);
    }),
  );

  // Si no hay elección guardada, la página sigue los cambios del sistema en vivo
  system.addEventListener('change', () => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {
      saved = null;
    }
    if (!saved) {
      startSwitch();
      apply(systemTheme());
      requestAnimationFrame(() => requestAnimationFrame(endSwitch));
    }
  });

  sync();
</script>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--fill-strong);
    box-shadow: inset 0 0 0 1px var(--hairline-strong);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 0.25s,
      transform 0.3s var(--ease-out);
  }
  .theme-toggle:hover {
    background: var(--hairline-strong);
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      opacity 0.35s,
      transform 0.5s var(--ease-out);
  }
  /* En oscuro se ve el sol (la acción es pasar a claro); en claro, la luna */
  .theme-toggle__moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global(:root[data-theme='light']) .theme-toggle__sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  :global(:root[data-theme='light']) .theme-toggle__moon {
    opacity: 1;
    transform: none;
  }
  /* El aura vive fuera del botón (en <body>), por eso es global */
  :global(.theme-aura) {
    position: fixed;
    z-index: 10000;
    width: 220px;
    height: 220px;
    margin: -110px 0 0 -110px;
    border-radius: 50%;
    pointer-events: none;
    /* brillo tenue que se disuelve hacia afuera: sin borde ni anillo visible */
    background: radial-gradient(
      circle,
      rgba(61, 220, 151, 0.2) 0%,
      rgba(14, 159, 110, 0.1) 35%,
      rgba(14, 159, 110, 0) 70%
    );
    animation: theme-aura 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes theme-aura {
    0% {
      transform: scale(0.3);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      transform: scale(6);
      opacity: 0;
    }
  }
</style>
