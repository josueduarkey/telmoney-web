---
// El centro del producto: «¿cuánto puedo gastar hoy?» con la fórmula real del bot
// ((saldo − pagos fijos − ahorro) ÷ días hasta el próximo pago) y un simulador de compra.
const balance = 540;
const fixed = 300;
const goals = 1.3;
const days = 11;
const free = balance - fixed - goals; // 238.70
const perDay = free / days; // 21.70
const presets = [
  { label: 'Almuerzo', value: 6 },
  { label: 'Tenis', value: 80 },
  { label: 'Celular', value: 230 },
];
---

<section class="today band" id="hoy" data-today>
  <div class="container today__grid">
    <div>
      <h2 class="display">Un número<span class="pd">.</span> Todos los días<span class="pd">.</span></h2>
      <p class="lead today__lead">
        TelMoney no solo anota lo que ya gastaste. Te dice cuánto puedes gastar hoy, con tus pagos fijos y
        tu ahorro ya descontados, hasta que te vuelvan a pagar.
      </p>

      <dl class="formula num" aria-label="Cómo se calcula tu disponible">
        <div class="formula__row">
          <dt>Tienes en tus cuentas</dt>
          <dd><span data-count={balance}>${balance.toFixed(2)}</span></dd>
        </div>
        <div class="formula__row">
          <dt>Gastos fijos por pagar</dt>
          <dd>− <span data-count={fixed}>${fixed.toFixed(2)}</span></dd>
        </div>
        <div class="formula__row">
          <dt>Apartado para tus metas</dt>
          <dd>− <span data-count={goals}>${goals.toFixed(2)}</span></dd>
        </div>
        <div class="formula__row">
          <dt>Días hasta tu próximo pago (15/10)</dt>
          <dd>÷ <span data-count={days} data-int>{days}</span></dd>
        </div>
        <div class="formula__total">
          <dt>Hoy puedes gastar</dt>
          <dd><span data-count={perDay}>${perDay.toFixed(2)}</span><small> por día</small></dd>
        </div>
      </dl>
    </div>

    <div class="sim" data-sim data-free={free} data-days={days} data-per-day={perDay}>
      <p class="sim__q">
        ¿Puedo comprar algo de <output class="num" for="sim-range" data-sim-amount>$80</output>?
      </p>
      <label class="sr-only" for="sim-range">Precio de lo que quieres comprar</label>
      <input
        id="sim-range"
        class="sim__range"
        type="range"
        min="1"
        max="260"
        step="1"
        value="80"
        data-sim-range
      />
      <div class="sim__presets" role="group" aria-label="Ejemplos">
        {
          presets.map((p) => (
            <button type="button" data-sim-preset={p.value} aria-pressed={p.value === 80 ? 'true' : 'false'}>
              {p.label} ${p.value}
            </button>
          ))
        }
      </div>

      <div class="sim__reply" aria-live="polite" data-sim-reply>
        <p data-sim-head><strong>🟡 Puedes, pero se sale de lo de hoy</strong> ($21.70).</p>
        <p data-sim-body>
          Si lo compras, tu disponible baja de $21.70 a <strong>$14.43 por día</strong> hasta el 15/10.
        </p>
        <span class="sim__meter" aria-hidden="true"><span data-sim-meter></span></span>
      </div>
      <p class="sim__note">Simulación con los montos de ejemplo de arriba.</p>
    </div>
  </div>
</section>

<script>
  const sim = document.querySelector<HTMLElement>('[data-sim]');
  if (sim) {
    const free = Number(sim.dataset.free);
    const days = Number(sim.dataset.days);
    const perDay = Number(sim.dataset.perDay);
    const range = sim.querySelector<HTMLInputElement>('[data-sim-range]')!;
    const amount = sim.querySelector<HTMLOutputElement>('[data-sim-amount]')!;
    const head = sim.querySelector<HTMLElement>('[data-sim-head]')!;
    const body = sim.querySelector<HTMLElement>('[data-sim-body]')!;
    const reply = sim.querySelector<HTMLElement>('[data-sim-reply]')!;
    const meter = sim.querySelector<HTMLElement>('[data-sim-meter]')!;
    const presets = sim.querySelectorAll<HTMLButtonElement>('[data-sim-preset]');
    const usd = (n: number) => `$${n.toFixed(2)}`;
    const fmt = (n: number) => `$${Math.round(n)}`;

    const render = () => {
      const price = Number(range.value);
      const after = (free - price) / days;
      amount.textContent = fmt(price);
      range.style.setProperty('--p', `${((price - 1) / 259) * 100}%`);
      meter.style.setProperty('--p', `${Math.min(price / free, 1) * 100}%`);
      presets.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.simPreset) === price)));

      let state: 'ok' | 'warn' | 'no';
      if (price <= perDay) {
        state = 'ok';
        head.innerHTML = `<strong>🟢 Sí, entra en lo de hoy.</strong>`;
        body.innerHTML = `Te quedarían <strong>${usd(perDay - price)}</strong> de ${usd(perDay)} para el resto del día.`;
      } else if (after >= 0) {
        state = 'warn';
        head.innerHTML = `<strong>🟡 Puedes, pero se sale de lo de hoy</strong> (${usd(perDay)}).`;
        body.innerHTML = `Si lo compras, tu disponible baja de ${usd(perDay)} a <strong>${usd(after)} por día</strong> hasta el 15/10.`;
      } else {
        state = 'no';
        head.innerHTML = `<strong>🔴 Hoy no te alcanza.</strong>`;
        body.innerHTML = `Te faltarían <strong>${usd(price - free)}</strong> para llegar al 15/10 con tus pagos fijos cubiertos.`;
      }
      reply.dataset.state = state;
    };

    range.addEventListener('input', render);
    presets.forEach((b) =>
      b.addEventListener('click', () => {
        range.value = b.dataset.simPreset!;
        render();
      }),
    );
    render();
  }
</script>

<style>
  .today__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--s-8);
    align-items: center;
  }
  .today__lead {
    margin-top: var(--s-5);
  }

  .formula {
    margin: var(--s-7) 0 0;
    max-width: 520px;
  }
  .formula__row,
  .formula__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline-dark);
  }
  .formula dt {
    color: var(--on-dark-muted);
  }
  .formula dd {
    margin: 0;
    font-weight: 600;
    white-space: nowrap;
  }
  .formula__total {
    border-bottom: 0;
    padding-top: var(--s-5);
  }
  .formula__total dt {
    color: var(--white);
    font-weight: 600;
  }
  .formula__total dd {
    font-family: var(--font-ui);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--white);
  }
  .formula__total small {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--on-dark-muted);
  }

  .today {
    background: var(--black);
  }
  .sim {
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--r-xxl);
    background:
      radial-gradient(90% 70% at 100% 0%, rgba(36, 72, 128, 0.55), transparent 65%),
      var(--vault);
    color: var(--white);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      0 40px 80px -40px rgba(0, 0, 0, 0.9);
  }
  .sim__q {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .sim__q output {
    color: var(--green-glow);
  }
  .sim__range {
    --p: 30%;
    width: 100%;
    margin: var(--s-6) 0 var(--s-4);
    height: 28px;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .sim__range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--green) var(--p), rgba(255, 255, 255, 0.15) var(--p));
  }
  .sim__range::-moz-range-track {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--green) var(--p), rgba(255, 255, 255, 0.15) var(--p));
  }
  .sim__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 26px;
    height: 26px;
    margin-top: -10px;
    border-radius: 50%;
    background: var(--white);
    box-shadow:
      0 0 0 6px rgba(14, 159, 110, 0.35),
      0 4px 10px rgba(0, 0, 0, 0.4);
  }
  .sim__range::-moz-range-thumb {
    width: 26px;
    height: 26px;
    border: 0;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 0 0 6px rgba(14, 159, 110, 0.35);
  }
  .sim__presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .sim__presets button {
    min-height: 40px;
    padding: 8px 14px;
    border: 0;
    border-radius: var(--r-full);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px var(--hairline-dark);
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .sim__presets button:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .sim__presets button[aria-pressed='true'] {
    background: var(--white);
    color: var(--ink);
  }
  .sim__reply {
    margin-top: var(--s-6);
    padding: 16px 18px;
    border-radius: 6px 16px 16px 16px;
    background: var(--chat-in);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    transition: box-shadow 0.3s;
  }
  .sim__reply p + p {
    margin-top: 6px;
    color: rgba(234, 241, 250, 0.85);
  }
  .sim__reply[data-state='ok'] {
    box-shadow: inset 3px 0 0 var(--green-glow);
  }
  .sim__reply[data-state='warn'] {
    box-shadow: inset 3px 0 0 var(--gold);
  }
  .sim__reply[data-state='no'] {
    box-shadow: inset 3px 0 0 var(--coral);
  }
  .sim__meter {
    display: block;
    height: 4px;
    margin-top: var(--s-4);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .sim__meter span {
    --p: 33%;
    display: block;
    height: 100%;
    width: var(--p);
    background: currentColor;
    color: var(--gold);
    transition:
      width 0.4s var(--ease-out),
      color 0.3s;
  }
  [data-state='ok'] .sim__meter span {
    color: var(--green-glow);
  }
  [data-state='no'] .sim__meter span {
    color: var(--coral);
  }
  .sim__note {
    margin-top: var(--s-4);
    font-size: 0.8rem;
    color: var(--on-dark-faint);
  }

  @media (max-width: 991px) {
    .today__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
