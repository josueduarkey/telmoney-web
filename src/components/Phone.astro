---
// Maqueta de iPhone (marco de titanio, Dynamic Island, botones laterales)
// con la conversación en el modo oscuro de WhatsApp y su fondo de garabatos (public/whatsapp-fondo.png).
import Logo from "./Logo.astro";

interface Props {
  class?: string;
  /** Muestra el indicador «escribiendo…» (lo controla un script) */
  typing?: boolean;
  /** Campo de texto real y sugerencias: la demo en vivo (scripts/demo-bot.ts) */
  interactive?: boolean;
  label?: string;
}
const {
  class: cls = "",
  typing = false,
  interactive = false,
  label = "Conversación de ejemplo con TelMoney",
} = Astro.props;
const suggestions = [
  "gasté 5 en café",
  "¿cuánto puedo gastar hoy?",
  "¿puedo comprar unos tenis de 80?",
  "me pagaron 650",
];
---

<figure
  class:list={["phone", cls]}
  aria-label={label}
  data-cursor={interactive ? "Escríbele" : undefined}
>
  <span class="phone__btn phone__btn--action" aria-hidden="true"></span>
  <span class="phone__btn phone__btn--vol-up" aria-hidden="true"></span>
  <span class="phone__btn phone__btn--vol-down" aria-hidden="true"></span>
  <span class="phone__btn phone__btn--power" aria-hidden="true"></span>

  <div class="phone__bezel">
    <div class="phone__screen">
      <div class="phone__status num" aria-hidden="true">
        <span class="phone__time">9:41</span>
        <span class="phone__island"></span>
        <span class="phone__icons">
          <svg viewBox="0 0 18 12" width="17" height="11"
            ><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect
              x="5"
              y="5.5"
              width="3"
              height="6.5"
              rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"
            ></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg
          >
          <svg viewBox="0 0 16 12" width="15" height="11"
            ><path
              d="M8 2.2c2.3 0 4.4.9 6 2.4l1.2-1.3A10.2 10.2 0 0 0 8 .4 10.2 10.2 0 0 0 .8 3.3L2 4.6a8.4 8.4 0 0 1 6-2.4Zm0 3.6c1.3 0 2.5.5 3.4 1.3l1.2-1.3A6.6 6.6 0 0 0 8 4a6.6 6.6 0 0 0-4.6 1.8l1.2 1.3c.9-.8 2.1-1.3 3.4-1.3Zm0 3.5c-.4 0-.8.2-1.1.4L8 11l1.1-1.3c-.3-.2-.7-.4-1.1-.4Z"
            ></path></svg
          >
          <svg viewBox="0 0 27 12" width="25" height="11"
            ><rect
              x=".5"
              y=".5"
              width="22"
              height="11"
              rx="3.2"
              fill="none"
              stroke="currentColor"
              opacity=".45"></rect><rect
              x="2"
              y="2"
              width="17"
              height="8"
              rx="2"></rect><path
              d="M24.5 4v4c.8-.3 1.3-1 1.3-2s-.5-1.7-1.3-2Z"
              opacity=".5"></path></svg
          >
        </span>
      </div>

      <header class="phone__head">
        <svg
          class="phone__back"
          viewBox="0 0 12 20"
          width="11"
          height="18"
          aria-hidden="true"
          ><path
            d="M10 2 2 10l8 8"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
        <Logo size={34} wordmark={false} />
        <span class="phone__who">
          <b>TelMoney</b>
          <small data-presence>en línea</small>
        </span>
        <span class="phone__actions" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="21" height="21"
            ><path
              d="M15 8.5V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1.5l5 3.5V5l-5 3.5Z"
            ></path></svg
          >
          <svg viewBox="0 0 24 24" width="19" height="19"
            ><path
              d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"
            ></path></svg
          >
        </span>
      </header>

      <div class="phone__body" data-chat-body data-lenis-prevent>
        <span class="phone__day">Hoy</span>
        <slot />
        {
          typing && (
            <div class="typing" data-typing aria-hidden="true">
              <i />
              <i />
              <i />
            </div>
          )
        }
      </div>

      {
        interactive && (
          <div
            class="phone__chips"
            role="group"
            aria-label="Mensajes de ejemplo para probar"
          >
            {suggestions.map((t) => (
              <button type="button" data-chat-chip={t}>
                {t}
              </button>
            ))}
          </div>
        )
      }

      {
        interactive ? (
          <form class="phone__compose" data-chat-form autocomplete="off">
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              class="phone__plus"
              aria-hidden="true"
            >
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <label class="sr-only" for="demo-input">
              Escríbele a TelMoney (demo)
            </label>
            <input
              id="demo-input"
              class="phone__input"
              data-chat-input
              placeholder="Escribe un gasto…"
              maxlength="140"
              enterkeyhint="send"
            />
            <button class="phone__mic" type="submit" aria-label="Enviar">
              <svg
                class="phone__ico-mic"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path
                  d="M12 15a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-2.1a7 7 0 0 0 6-6.9h-2Z"
                  fill="currentColor"
                />
              </svg>
              <svg
                class="phone__ico-send"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path
                  d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z"
                  fill="currentColor"
                />
              </svg>
            </button>
          </form>
        ) : (
          <footer class="phone__compose" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" class="phone__plus">
              <path
                d="M12 5v14M5 12h14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <span class="phone__input">Mensaje</span>
            <span class="phone__mic">
              <svg viewBox="0 0 24 24" width="18" height="18">
                <path
                  d="M12 15a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-2.1a7 7 0 0 0 6-6.9h-2Z"
                  fill="currentColor"
                />
              </svg>
            </span>
          </footer>
        )
      }
      <span class="phone__home" aria-hidden="true"></span>
    </div>
  </div>
</figure>

<style>
  .phone {
    --w: 340px;
    position: relative;
    margin: 0;
    width: min(var(--w), 100%);
    aspect-ratio: 71.6 / 147.6;
    padding: 3px;
    border-radius: 60px;
    /* Titanio natural: reflejos suaves en el marco */
    background: linear-gradient(
      135deg,
      #6b6e72 0%,
      #2b2d30 18%,
      #8a8d91 34%,
      #1d1e20 52%,
      #5d6064 70%,
      #232426 86%,
      #7c7f83 100%
    );
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.8),
      0 60px 120px -30px rgba(0, 0, 0, 0.95),
      0 0 80px -20px rgba(14, 159, 110, 0.25);
  }
  .phone__bezel {
    height: 100%;
    padding: 9px;
    border-radius: 57px;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .phone__btn {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #3a3c3f, #7c7f83 60%, #2b2d30);
  }
  .phone__btn--action {
    left: -3px;
    top: 17%;
    height: 5%;
  }
  .phone__btn--vol-up {
    left: -3px;
    top: 25%;
    height: 9%;
  }
  .phone__btn--vol-down {
    left: -3px;
    top: 36%;
    height: 9%;
  }
  .phone__btn--power {
    right: -3px;
    top: 29%;
    height: 14%;
  }

  .phone__screen {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 48px;
    overflow: hidden;
    background: var(--chat-bg);
    color: #e9edef;
  }
  .phone__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 24px 6px 30px;
    background: var(--chat-head);
    font-size: 0.8rem;
    font-weight: 600;
    color: #fff;
  }
  .phone__time {
    width: 54px;
  }
  .phone__island {
    width: 96px;
    height: 28px;
    border-radius: 20px;
    background: #000;
  }
  .phone__icons {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 64px;
    justify-content: flex-end;
  }
  .phone__icons svg {
    fill: currentColor;
  }
  .phone__head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px 9px 10px;
    background: var(--chat-head);
  }
  .phone__back {
    color: #aebac1;
  }
  .phone__who {
    display: flex;
    flex-direction: column;
    flex: 1;
    line-height: 1.2;
    font-size: 0.92rem;
  }
  .phone__who small {
    font-size: 0.7rem;
    color: #8696a0;
  }
  .phone__actions {
    display: flex;
    gap: 16px;
    color: #aebac1;
  }
  .phone__actions svg {
    fill: currentColor;
  }

  .phone__body {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 9px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    background: var(--chat-bg) url("/whatsapp-fondo.png") center / cover;
    background-attachment: local;
  }
  .phone__body::-webkit-scrollbar {
    display: none;
  }
  .phone__day {
    align-self: center;
    margin-top: auto;
    padding: 4px 10px;
    border-radius: 7px;
    background: #182229;
    color: #8696a0;
    font-size: 0.66rem;
    font-weight: 500;
  }
  .phone__compose {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px 26px;
    background: var(--chat-head);
  }
  .phone__plus {
    color: #aebac1;
  }
  .phone__input {
    flex: 1;
    min-width: 0;
    padding: 8px 14px;
    border: 0;
    border-radius: 20px;
    background: #2a3942;
    color: #8696a0;
    font-size: 0.82rem;
  }
  input.phone__input {
    /* 16px evita el zoom automático de iOS al tocar el campo */
    font-size: 16px;
    color: #e9edef;
    outline: none;
  }
  input.phone__input::placeholder {
    color: #8696a0;
  }
  input.phone__input:focus {
    box-shadow: 0 0 0 1.5px rgba(61, 220, 151, 0.6);
  }
  .phone__mic {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
  }
  button.phone__mic {
    cursor: pointer;
  }
  .phone__ico-send,
  .has-text .phone__ico-mic {
    display: none;
  }
  .has-text .phone__ico-send {
    display: block;
  }

  /* Sugerencias para tocar, justo encima del campo de texto */
  .phone__chips {
    display: flex;
    gap: 6px;
    padding: 8px 9px 2px;
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--chat-head);
  }
  .phone__chips::-webkit-scrollbar {
    display: none;
  }
  .phone__chips button {
    flex: none;
    padding: 7px 12px;
    border: 0;
    border-radius: 16px;
    background: #2a3942;
    color: #e9edef;
    font-size: 0.74rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }
  .phone__chips button:hover {
    background: #005c4b;
  }
  .phone__chips button:active {
    transform: scale(0.95);
  }
  .phone__home {
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 38%;
    height: 5px;
    translate: -50% 0;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.85);
  }

  .typing {
    align-self: flex-start;
    display: none;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 8px;
    border-top-left-radius: 0;
    background: var(--chat-in);
  }
  .typing.is-on {
    display: flex;
  }
  .typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(233, 237, 239, 0.7);
    animation: blink 1.2s infinite ease-in-out;
  }
  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
</style>
