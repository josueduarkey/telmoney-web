---
import Logo from './Logo.astro';

interface Props {
  class?: string;
  /** Muestra el indicador «escribiendo…» (lo controla un script) */
  typing?: boolean;
  label?: string;
}
const { class: cls = '', typing = false, label = 'Conversación de ejemplo con TelMoney' } = Astro.props;
---

<figure class:list={['phone', cls]} aria-label={label}>
  <div class="phone__screen">
    <div class="phone__status num" aria-hidden="true">
      <span>9:41</span>
      <span class="phone__island"></span>
      <span class="phone__icons">●●● ▮</span>
    </div>
    <header class="phone__head">
      <span class="phone__back" aria-hidden="true">‹</span>
      <Logo size={34} wordmark={false} />
      <span class="phone__who">
        <b>TelMoney</b>
        <small data-presence>en línea</small>
      </span>
    </header>
    <div class="phone__body" data-chat-body>
      <slot />
      {
        typing && (
          <div class="typing" data-typing aria-hidden="true">
            <i />
            <i />
            <i />
          </div>
        )
      }
    </div>
    <footer class="phone__compose" aria-hidden="true">
      <span class="phone__input">Mensaje</span>
      <span class="phone__mic">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path
            d="M12 15a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-2.1a7 7 0 0 0 6-6.9h-2Z"
            fill="currentColor"></path>
        </svg>
      </span>
    </footer>
  </div>
</figure>

<style>
  .phone {
    --w: 340px;
    position: relative;
    margin: 0;
    width: min(var(--w), 100%);
    aspect-ratio: 9 / 18.6;
    padding: 11px;
    border-radius: 54px;
    background: linear-gradient(145deg, #3b3f46, #0b0c0e 40%, #24272c);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.12),
      0 50px 100px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(0, 0, 0, 0.6);
  }
  .phone__screen {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 44px;
    overflow: hidden;
    background:
      radial-gradient(120% 60% at 50% 0%, rgba(120, 160, 220, 0.12), transparent 60%),
      var(--chat-bg);
  }
  .phone__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 26px 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
  }
  .phone__island {
    width: 92px;
    height: 26px;
    border-radius: 20px;
    background: #000;
  }
  .phone__icons {
    font-size: 0.55rem;
    letter-spacing: 1px;
  }
  .phone__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(11, 26, 45, 0.6);
    backdrop-filter: blur(10px);
  }
  .phone__back {
    font-size: 1.6rem;
    line-height: 1;
    color: #9dbce6;
  }
  .phone__who {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    font-size: 0.9rem;
  }
  .phone__who small {
    font-size: 0.7rem;
    color: var(--chat-meta);
  }
  .phone__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 12px 10px;
    overflow: hidden;
  }
  .phone__compose {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px 18px;
  }
  .phone__input {
    flex: 1;
    padding: 9px 14px;
    border-radius: 20px;
    background: var(--chat-in);
    color: var(--chat-meta);
    font-size: 0.82rem;
  }
  .phone__mic {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--green);
    color: var(--ink);
  }

  .typing {
    align-self: flex-start;
    display: none;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 10px;
    border-top-left-radius: 3px;
    background: var(--chat-in);
  }
  .typing.is-on {
    display: flex;
  }
  .typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(234, 241, 250, 0.7);
    animation: blink 1.2s infinite ease-in-out;
  }
  .typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
</style>
