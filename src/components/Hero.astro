---
import Phone from './Phone.astro';
import Chat from './Chat.astro';
import Sticker from './Sticker.astro';
import { heroScript } from '../data/chats';
import { CTA, LAUNCHED } from '../config';

// Máximo 3 frases. La primera es el tagline y es la que queda si no hay movimiento.
const phrases = ['en orden,', 'sin sorpresas,', 'bajo control,'];
---

<section class="hero" id="top" data-hero>
  <!-- Fondo: luces esmeralda que se mueven solas y un foco que sigue al cursor -->
  <div class="hero__bg" aria-hidden="true" data-hero-bg>
    <div class="aurora">
      <i class="aurora__a"></i>
      <i class="aurora__b"></i>
      <i class="aurora__c"></i>
    </div>
    <div class="spot"></div>
    <div class="vignette"></div>
  </div>

  {
    LAUNCHED && (
      <p class="hero__open container" data-hero-in>
        Ya está abierto en El Salvador
      </p>
    )
  }

  <div class="hero__grid container">
    <div class="hero__copy">

      <h1 class="display-hero" data-hero-title aria-label={`Tu pisto ${phrases[0]} por WhatsApp.`}>
        <span class="hl" aria-hidden="true"><span class="hl__in">Tu pisto</span></span>
        <span class="hl" aria-hidden="true"
          ><span class="hl__in"
            ><span class="chip type" data-type={JSON.stringify(phrases)}
              ><span data-type-text>{phrases[0]}</span><span class="caret"></span></span
            ></span
          ></span
        >
        <span class="hl" aria-hidden="true"
          ><span class="hl__in">por&nbsp;WhatsApp<span class="pd">.</span></span></span
        >
      </h1>

      <p class="lead hero__sub" data-hero-in>
        Mándale un mensaje, una foto del recibo o un audio. TelMoney anota todo, te dice cuánto puedes
        gastar hoy y te avisa antes de cada pago. Sin apps, sin Excel.
      </p>
      <div class="hero__ctas" data-hero-in>
        <a
          class="btn btn--primary"
          href={CTA.href}
          data-magnetic
          {...CTA.external ? { target: '_blank', rel: 'noopener' } : {}}>{CTA.label}</a
        >
        <a class="btn btn--ghost" href="#antes-y-despues">Ver el antes y después</a>
      </div>
      <p class="hero__fine" data-hero-in>
        7 días gratis con todo incluido. No pedimos tarjeta ni claves del banco.
      </p>
    </div>

    <div class="hero__stage" data-hero-phone>
      <Phone
        typing
        interactive
        label="Demo de TelMoney: anota un almuerzo y una nota de voz; después puedes escribirle tú">
        <Chat messages={heroScript} scripted />
      </Phone>
      <p class="hero__try" aria-hidden="true">
        <span>Pruébalo, escríbele</span>
        <svg viewBox="0 0 60 40" width="60" height="40"
          ><path d="M4 6c18 0 34 6 46 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path><path d="M41 28l9 3 1-10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        >
      </p>
      <Sticker kind="coin" size={92} class="hero__coin" data-float="2" />
    </div>
  </div>

  <a href="#antes-y-despues" class="hero__scroll" aria-label="Seguir bajando">
    <span></span>
  </a>
</section>

<script>
  import { playChat } from '../scripts/chat';
  import { typewriter } from '../scripts/typewriter';
  import { heroBackground } from '../scripts/hero-bg';

  import { demoBot } from '../scripts/demo-bot';

  const stage = document.querySelector<HTMLElement>('[data-hero-phone]');
  if (stage) {
    // El guion se reproduce una vez; en cuanto la persona toca o escribe, la conversación es suya
    const script = new AbortController();
    playChat(stage, { startDelay: 1400, signal: script.signal });
    demoBot(stage, { onFirstInteraction: () => script.abort() });
  }

  const type = document.querySelector<HTMLElement>('[data-type]');
  if (type) typewriter(type, { startDelay: 2600 });

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) heroBackground(hero);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 108px 72px;
    overflow: hidden;
    isolation: isolate;
    background: var(--black);
  }

  /* ── Fondo ── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  /* Luces: degradados radiales suaves; se mueven solo con transform (sin blur ni mezclas: van fluidas) */
  .aurora {
    position: absolute;
    inset: -10%;
    will-change: transform;
  }
  .aurora i {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }
  .aurora__a {
    width: 64vw;
    height: 64vw;
    right: -12vw;
    top: -22vw;
    background: radial-gradient(circle, rgba(6, 95, 70, 0.75), rgba(6, 95, 70, 0.25) 38%, rgba(4, 35, 26, 0) 70%);
    animation: drift-a 26s ease-in-out infinite alternate;
  }
  .aurora__b {
    width: 46vw;
    height: 46vw;
    left: 14vw;
    bottom: -26vw;
    background: radial-gradient(circle, rgba(14, 159, 110, 0.32), rgba(14, 159, 110, 0.1) 40%, rgba(14, 159, 110, 0) 70%);
    animation: drift-b 32s ease-in-out infinite alternate;
  }
  .aurora__c {
    width: 34vw;
    height: 34vw;
    right: 20vw;
    top: 28%;
    background: radial-gradient(circle, rgba(214, 219, 216, 0.1), rgba(214, 219, 216, 0) 68%);
    animation: drift-c 22s ease-in-out infinite alternate;
  }
  @keyframes drift-a {
    to {
      transform: translate3d(-12vw, 10vw, 0) scale(1.15);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate3d(16vw, -8vw, 0) scale(0.9);
    }
  }
  @keyframes drift-c {
    to {
      transform: translate3d(-10vw, 6vw, 0) scale(1.25);
    }
  }

  /* Foco de luz: un círculo fijo que se traslada (no se repinta). Sin cursor, pasea solo. */
  .spot {
    position: absolute;
    left: 0;
    top: 0;
    width: 760px;
    height: 760px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(61, 220, 151, 0.16),
      rgba(14, 159, 110, 0.06) 45%,
      transparent 72%
    );
    will-change: transform;
    animation: spot-wander 18s ease-in-out infinite alternate;
  }
  .has-pointer .spot {
    animation: none;
  }
  @keyframes spot-wander {
    0% {
      transform: translate3d(calc(55vw - 380px), calc(20svh - 380px), 0);
    }
    50% {
      transform: translate3d(calc(80vw - 380px), calc(60svh - 380px), 0);
    }
    100% {
      transform: translate3d(calc(40vw - 380px), calc(75svh - 380px), 0);
    }
  }
  .vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 30% 50%, transparent 40%, rgba(0, 0, 0, 0.75) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0) 70%, var(--black) 100%);
  }

  /* ── Contenido ── */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--s-8);
  }
  .hero__open {
    margin-bottom: var(--s-6);
    text-align: center;
    color: var(--on-dark-muted);
  }
  .hero h1 {
    max-width: 10em;
  }
  /* Cada línea del título sube desde su propia máscara; el aire abajo evita cortar la «p» */
  .hl {
    display: block;
    overflow: clip;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hl__in {
    display: block;
  }
  .type {
    white-space: nowrap;
    min-width: 0.6em;
  }
  .caret {
    display: inline-block;
    width: 0.07em;
    height: 0.82em;
    margin-left: 0.05em;
    vertical-align: -0.06em;
    background: var(--black);
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .hero__sub {
    margin-top: var(--s-6);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-7);
  }
  .hero__fine {
    margin-top: var(--s-5);
    font-size: var(--fs-small);
    color: var(--on-dark-faint);
  }

  .hero__stage {
    --pw: 364px; /* ancho del teléfono: la etiqueta «Pruébalo» se ubica respecto a él */
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero__stage :global(.phone) {
    --w: var(--pw);
    rotate: 3deg;
  }
  .hero__try {
    position: absolute;
    align-items: flex-start;
    /* justo a la izquierda del teléfono, apuntando al campo de texto */
    right: calc(50% + var(--pw) / 2 - 30px);
    bottom: 10%;
    z-index: 3;
    white-space: nowrap;
    display: flex;
    align-items: flex-start;
    gap: 4px;
    color: var(--green-glow);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    transform: rotate(-6deg);
    pointer-events: none;
    transition: opacity 0.5s;
  }
  .hero__try svg {
    flex: none;
    max-width: none;
    margin-top: 10px;
  }
  .hero__stage:global(.is-live) .hero__try {
    opacity: 0;
  }
  .hero :global(.hero__coin) {
    right: -2%;
    top: 6%;
    rotate: 12deg;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1.5px var(--hairline-dark-strong);
  }
  .hero__scroll span {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 3px;
    height: 8px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--white);
    animation: wheel 2s infinite var(--ease-out);
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 991px) {
    .hero {
      padding-top: 110px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .hero__stage {
      flex-direction: column;
      align-items: center;
    }
    .hero__stage {
      --pw: 336px;
    }
    .hero__stage :global(.phone) {
      --w: 290px;
      rotate: 0deg;
    }
    .hero__try {
      position: static;
      order: -1;
      margin-bottom: var(--s-3);
      transform: none;
    }
    .hero__try svg {
      rotate: 60deg;
    }
    .hero__scroll {
      display: none;
    }
    .aurora__a {
      width: 120vw;
      height: 120vw;
    }
    .aurora__b {
      width: 100vw;
      height: 100vw;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      display: none;
    }
  }
</style>
