---
import Phone from './Phone.astro';
import Chat from './Chat.astro';
import Sticker from './Sticker.astro';
import Countdown from './Countdown.astro';
import { heroScript } from '../data/chats';
import { CTA, LAUNCHED } from '../config';

// Máximo 3 frases. La primera es el tagline y es la que queda si no hay movimiento.
const phrases = ['en orden,', 'sin sorpresas,', 'bajo control,'];
---

<section class="hero" id="top" data-hero>
  <!-- Fondo: luces que siguen al cursor y un grabado de billete que se revela donde apunta -->
  <div class="hero__bg" aria-hidden="true" data-hero-bg>
    <div class="aurora">
      <i class="aurora__a"></i>
      <i class="aurora__b"></i>
      <i class="aurora__c"></i>
    </div>
    <div class="engrave"></div>
    <div class="engrave engrave--lit"></div>
    <div class="vignette"></div>
  </div>

  <div class="hero__grid container">
    <div class="hero__copy">
      {
        LAUNCHED ? (
          <p class="hero__open" data-hero-in>
            Ya está abierto en El Salvador
          </p>
        ) : (
          <div data-hero-in>
            <Countdown />
          </div>
        )
      }

      <h1 class="display-hero" data-hero-title aria-label={`Tu pisto ${phrases[0]} por WhatsApp.`}>
        <span class="hl" aria-hidden="true"><span class="hl__in">Tu pisto</span></span>
        <span class="hl" aria-hidden="true"
          ><span class="hl__in"
            ><span class="chip type" data-type={JSON.stringify(phrases)}
              ><span data-type-text>{phrases[0]}</span><span class="caret"></span></span
            ></span
          ></span
        >
        <span class="hl" aria-hidden="true"
          ><span class="hl__in">por&nbsp;WhatsApp<span class="pd">.</span></span></span
        >
      </h1>

      <p class="lead hero__sub" data-hero-in>
        Mándale un mensaje, una foto del recibo o un audio. TelMoney anota todo, te dice cuánto puedes
        gastar hoy y te avisa antes de cada pago. Sin apps, sin Excel.
      </p>
      <div class="hero__ctas" data-hero-in>
        <a
          class="btn btn--primary"
          href={CTA.href}
          data-magnetic
          {...CTA.external ? { target: '_blank', rel: 'noopener' } : {}}>{CTA.label}</a
        >
        <a class="btn btn--ghost" href="#antes-y-despues">Ver el antes y después</a>
      </div>
      <p class="hero__fine" data-hero-in>
        7 días gratis con todo incluido. No pedimos tarjeta ni claves del banco.
      </p>
    </div>

    <div class="hero__stage" data-hero-phone>
      <Phone typing label="TelMoney anotando un almuerzo, una nota de voz y una consulta de compra">
        <Chat messages={heroScript} scripted />
      </Phone>
      <Sticker kind="coin" size={92} class="hero__coin" data-float="2" />
    </div>
  </div>

  <a href="#antes-y-despues" class="hero__scroll" aria-label="Seguir bajando">
    <span></span>
  </a>
</section>

<script>
  import { playChat } from '../scripts/chat';
  import { typewriter } from '../scripts/typewriter';
  import { heroBackground } from '../scripts/hero-bg';

  const stage = document.querySelector<HTMLElement>('[data-hero-phone]');
  if (stage) playChat(stage, { loop: true, startDelay: 1400 });

  const type = document.querySelector<HTMLElement>('[data-type]');
  if (type) typewriter(type, { startDelay: 2600 });

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) heroBackground(hero);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 120px 80px;
    overflow: hidden;
    isolation: isolate;
    background: var(--black);
  }

  /* ── Fondo ── */
  .hero__bg {
    --mx: 70%;
    --my: 40%;
    --px: 0;
    --py: 0;
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .aurora {
    position: absolute;
    inset: -10%;
    filter: blur(70px) saturate(120%);
    transform: translate3d(calc(var(--px) * 40px), calc(var(--py) * 30px), 0);
  }
  .aurora i {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: screen;
  }
  .aurora__a {
    width: 58vw;
    height: 58vw;
    right: -8vw;
    top: -18vw;
    background: radial-gradient(circle, rgba(36, 72, 128, 0.9), rgba(18, 38, 63, 0) 68%);
    animation: drift-a 26s ease-in-out infinite alternate;
  }
  .aurora__b {
    width: 40vw;
    height: 40vw;
    left: 18vw;
    bottom: -22vw;
    background: radial-gradient(circle, rgba(14, 159, 110, 0.42), rgba(14, 159, 110, 0) 66%);
    animation: drift-b 32s ease-in-out infinite alternate;
  }
  .aurora__c {
    width: 30vw;
    height: 30vw;
    right: 22vw;
    top: 30%;
    background: radial-gradient(circle, rgba(201, 214, 230, 0.16), rgba(201, 214, 230, 0) 65%);
    animation: drift-c 22s ease-in-out infinite alternate;
  }
  @keyframes drift-a {
    to {
      transform: translate(-12vw, 10vw) scale(1.15);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate(16vw, -8vw) scale(0.9);
    }
  }
  @keyframes drift-c {
    to {
      transform: translate(-10vw, 6vw) scale(1.25);
    }
  }

  /* Grabado de billete: casi invisible, y se enciende alrededor del cursor */
  .engrave {
    position: absolute;
    inset: 0;
    background: var(--silver);
    opacity: 0.05;
    -webkit-mask: url('/guilloche.svg') 0 0 / 640px repeat;
    mask: url('/guilloche.svg') 0 0 / 640px repeat;
  }
  .engrave--lit {
    opacity: 0.5;
    background: linear-gradient(120deg, var(--silver), #8fd9bb);
    -webkit-mask:
      radial-gradient(circle 260px at var(--mx) var(--my), #000 0%, rgba(0, 0, 0, 0.35) 45%, transparent 100%),
      url('/guilloche.svg') 0 0 / 640px repeat;
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle 260px at var(--mx) var(--my), #000 0%, rgba(0, 0, 0, 0.35) 45%, transparent 100%),
      url('/guilloche.svg') 0 0 / 640px repeat;
    mask-composite: intersect;
  }
  .vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 30% 50%, transparent 40%, rgba(0, 0, 0, 0.75) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0) 70%, var(--black) 100%);
  }

  /* ── Contenido ── */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--s-8);
  }
  .hero__copy :global(.cd) {
    margin-bottom: var(--s-6);
  }
  .hero__open {
    margin-bottom: var(--s-5);
    color: var(--on-dark-muted);
  }
  .hero h1 {
    max-width: 10em;
  }
  /* Cada línea del título sube desde su propia máscara; el aire abajo evita cortar la «p» */
  .hl {
    display: block;
    overflow: clip;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hl__in {
    display: block;
  }
  .type {
    white-space: nowrap;
    min-width: 0.6em;
  }
  .caret {
    display: inline-block;
    width: 0.07em;
    height: 0.82em;
    margin-left: 0.05em;
    vertical-align: -0.06em;
    background: var(--black);
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  .hero__sub {
    margin-top: var(--s-6);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-7);
  }
  .hero__fine {
    margin-top: var(--s-5);
    font-size: var(--fs-small);
    color: var(--on-dark-faint);
  }

  .hero__stage {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero__stage :global(.phone) {
    rotate: 3deg;
  }
  .hero :global(.hero__coin) {
    right: -2%;
    top: 6%;
    rotate: 12deg;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border-radius: 14px;
    box-shadow: inset 0 0 0 1.5px var(--hairline-dark-strong);
  }
  .hero__scroll span {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 3px;
    height: 8px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--white);
    animation: wheel 2s infinite var(--ease-out);
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 991px) {
    .hero {
      padding-top: 110px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .hero__stage :global(.phone) {
      --w: 290px;
      rotate: 0deg;
    }
    .hero__scroll {
      display: none;
    }
    .aurora__a {
      width: 110vw;
      height: 110vw;
    }
    .aurora__b {
      width: 90vw;
      height: 90vw;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      display: none;
    }
  }
</style>
