---
import type { Msg } from '../data/chats';
import { wa } from '../lib/wa';
import { TICKS_SVG } from '../lib/ticks';

interface Props {
  messages: Msg[];
  /** Marca cada burbuja con data-step para que un script la anime */
  scripted?: boolean;
  compact?: boolean;
}
const { messages, scripted = false, compact = false } = Astro.props;
---

<ol class:list={['chat', { 'chat--compact': compact }]} role="list">
  {
    messages.map((m, i) => (
      <li class:list={['msg', `msg--${m.from}`]} data-step={scripted ? i : undefined}>
        <div class="bubble">
          {m.voice && (
            <span class="voice" aria-label={`Nota de voz de ${m.voice}`}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d="M8 5v14l11-7z" fill="currentColor" />
              </svg>
              <span class="voice__wave" aria-hidden="true">
                {Array.from({ length: 26 }, (_, k) => (
                  <i style={`--h:${0.25 + Math.abs(Math.sin(k * 1.7)) * 0.75}`} />
                ))}
              </span>
              <span class="voice__len num">{m.voice}</span>
            </span>
          )}
          {m.receipt && (
            <span class="receipt" aria-label={`Foto de recibo de ${m.receipt.merchant}`}>
              <span class="receipt__paper">
                <b>{m.receipt.merchant}</b>
                <span />
                <span />
                <span />
                <b class="num">TOTAL {m.receipt.total}</b>
              </span>
            </span>
          )}
          {m.text && <span class="text" set:html={wa(m.text)} />}
          {m.time && <span class="time num">{m.time}{m.from === 'me' && <Fragment set:html={TICKS_SVG} />}</span>}
        </div>
        {m.buttons && (
          <div class="quick" aria-label="Botones">
            {m.buttons.map((b) => (
              <span class="quick__btn">{b}</span>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ol>

<style is:global>
  /* Global a propósito: la demo del inicio crea mensajes en vivo con estas mismas clases. */
  .chat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 0.86rem;
    line-height: 1.42;
    color: var(--chat-text);
  }
  .chat--compact {
    font-size: 0.8rem;
  }
  .chat .msg {
    display: flex;
    flex-direction: column;
    max-width: 86%;
  }
  .chat .msg--me {
    margin-right: 8px;
  }
  .chat .msg--bot {
    margin-left: 8px;
  }
  .chat .msg--me {
    align-self: flex-end;
    align-items: flex-end;
  }
  .chat .msg--bot {
    align-self: flex-start;
  }
  .chat .bubble {
    position: relative;
    padding: 6px 9px 5px;
    border-radius: 8px;
    background: var(--chat-in);
    box-shadow: 0 1px 0.5px rgba(0, 0, 0, 0.3);
  }
  /* La colita de la burbuja, como en WhatsApp */
  .chat .bubble::before {
    content: '';
    position: absolute;
    top: 0;
    width: 8px;
    height: 13px;
    background: inherit;
  }
  .chat .msg--me .bubble {
    background: var(--chat-out);
    border-top-right-radius: 0;
  }
  .chat .msg--me .bubble::before {
    right: -8px;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .chat .msg--bot .bubble {
    border-top-left-radius: 0;
  }
  .chat .msg--bot .bubble::before {
    left: -8px;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }
  .chat .text {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .chat .text strong {
    font-weight: 650;
    color: var(--chat-strong);
  }
  .chat .text em {
    color: var(--chat-soft);
  }
  .chat .time {
    float: right;
    margin: 6px 0 -2px 10px;
    font-size: 0.66rem;
    color: var(--chat-meta);
  }
  /* sobre la burbuja verde la hora necesita otro tono para leerse (4.5:1) */
  .chat .msg--me .time {
    color: var(--chat-meta-out);
  }
  .chat .ticks {
    display: inline-block;
    margin-left: 3px;
    vertical-align: -1px;
    color: var(--chat-tick);
  }
  .chat .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
    width: 100%;
  }
  .chat .quick__btn {
    flex: 1 1 auto;
    text-align: center;
    padding: 7px 10px;
    border-radius: 9px;
    background: var(--chat-in);
    color: var(--chat-quick);
    font-weight: 600;
    font-size: 0.92em;
    white-space: nowrap;
  }

  .chat .voice {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 190px;
    color: var(--chat-voice);
  }
  .chat .voice__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 22px;
    flex: 1;
  }
  .chat .voice__wave i {
    width: 2.5px;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: currentColor;
    opacity: 0.8;
  }
  .chat .voice__len {
    font-size: 0.72rem;
    color: var(--chat-meta);
  }
  .chat .msg--me .voice__len {
    color: var(--chat-meta-out);
  }

  .chat .receipt {
    display: block;
    padding: 10px;
    margin: -3px -6px 4px;
    border-radius: 7px;
    background: #d9e2dc;
  }
  .chat .receipt__paper {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 150px;
    padding: 10px;
    background: #fff;
    color: #222;
    font-size: 0.7rem;
    transform: rotate(-2deg);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }
  .chat .receipt__paper span {
    height: 4px;
    background: #ddd;
    border-radius: 2px;
  }
  .chat .receipt__paper span:nth-of-type(2) {
    width: 70%;
  }
</style>
