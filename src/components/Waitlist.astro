---
import Sticker from './Sticker.astro';
import Countdown from './Countdown.astro';
import ShareButtons from './ShareButtons.astro';
import { LAUNCHED, WHATSAPP_URL, WAITLIST_URL } from '../config';
import { PAINS as pains } from '../data/pains';
---

<section class="beta band grain" id="beta">
  <Sticker kind="bell" size={110} class="beta__bell" data-float="2" />

  {
    !LAUNCHED && (
      <div class="container beta__countdown">
        <Countdown size="xl" label="La beta abre el 1 de noviembre. Faltan:" />
      </div>
    )
  }
  <div class="container beta__grid">
    <div class="beta__copy">
      <h2 class="display-hero beta__title">Que tu dinero te alcance todo el mes<span class="pd">.</span></h2>
      <p class="lead">
        {
          LAUNCHED
            ? 'Escríbele "hola" y en un minuto ya estás anotando. 7 días gratis con todo lo de Pro.'
            : 'Abrimos la beta el 1 de noviembre. Déjanos tu WhatsApp y sé de los primeros en probarlo, con 7 días gratis de Pro.'
        }
      </p>
    </div>

    {
      LAUNCHED ? (
        <div class="beta__card beta__card--launch">
          <a class="btn btn--primary btn--block" href={WHATSAPP_URL} target="_blank" rel="noopener">
            Pruébalo gratis 7 días
          </a>
          <p class="beta__fine">Se abre WhatsApp con el mensaje "Hola TelMoney" listo para mandar.</p>
        </div>
      ) : (
        <form class="beta__card" data-waitlist data-endpoint={WAITLIST_URL} novalidate>
          <div class="field">
            <label for="wl-name">Tu nombre</label>
            <input id="wl-name" name="name" autocomplete="given-name" required maxlength="80" />
            <span class="field__err" data-err-for="name" />
          </div>
          <div class="field">
            <label for="wl-phone">Tu WhatsApp</label>
            <div class="field__phone">
              <span aria-hidden="true">+503</span>
              <input
                id="wl-phone"
                name="whatsapp"
                type="tel"
                inputmode="tel"
                autocomplete="tel-national"
                placeholder="7000 0000"
                required
                aria-describedby="wl-phone-hint"
              />
            </div>
            <span class="field__hint" id="wl-phone-hint">
              Por ahí te avisamos. ¿Número de otro país? Escríbelo con su código, ej. +1.
            </span>
            <span class="field__err" data-err-for="whatsapp" />
          </div>
          <div class="field">
            <label for="wl-email">
              Correo <span class="opt">(opcional)</span>
            </label>
            <input id="wl-email" name="email" type="email" autocomplete="email" />
            <span class="field__err" data-err-for="email" />
          </div>
          <fieldset class="field">
            <legend>
              ¿Qué es lo que más te cuesta con tu dinero?
              <span class="opt">(puedes elegir varias, opcional)</span>
            </legend>
            <div class="pains">
              {pains.map((p) => (
                <label class="pain">
                  <input type="checkbox" name="pains" value={p} />
                  <span>{p}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <input class="hp" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <button class="btn btn--primary btn--block" type="submit" data-submit data-cursor="Únete">
            Unirme a la beta
          </button>
          <p class="beta__fine">Solo te escribimos por WhatsApp para avisarte de la beta. Nada de spam.</p>
          <p class="beta__status" role="status" aria-live="polite" data-status />
        </form>
      )
    }
  </div>

  {
    !LAUNCHED && (
      <dialog class="beta-modal" aria-labelledby="beta-done-title" aria-describedby="beta-done-text" data-done>
        <span class="beta__check" aria-hidden="true">
          <svg viewBox="0 0 52 52" width="72" height="72">
            <circle cx="26" cy="26" r="24" />
            <path d="m15 27 7 7 15-16" />
          </svg>
        </span>
        <h3 class="beta-modal__title" id="beta-done-title">Registro completado</h3>
        <p class="beta-modal__text" id="beta-done-text">
          Te escribimos por WhatsApp cuando abra la beta, el 1 de noviembre.
        </p>
        <ShareButtons class="beta__share" label="Mientras tanto, pásaselo a quien siempre pregunta en qué se le fue el dinero:" />
        <form method="dialog" class="beta-modal__actions">
          <button class="btn btn--primary btn--block" autofocus>Listo</button>
        </form>
      </dialog>
    )
  }
</section>

<script>
  import { initWaitlist } from '../scripts/waitlist';
  const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
  if (form) initWaitlist(form);
</script>

<style>
  .beta {
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 70% at 15% 100%, var(--band-glow), transparent 70%),
      var(--bg);
  }
  .beta :global(.beta__bell) {
    right: 6%;
    top: -50px;
    rotate: 14deg;
  }
  .beta__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--s-8);
    align-items: center;
  }
  .beta__title {
    font-size: clamp(2.6rem, 5.4vw, 4.8rem);
    max-width: 10em;
  }
  .beta__countdown {
    margin-bottom: var(--s-8);
  }
  .beta__copy .lead {
    margin-top: var(--s-5);
  }

  .beta__card {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--r-xxl);
    background: var(--glass);
    box-shadow: inset 0 0 0 1px var(--hairline-strong);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .field label,
  .field legend {
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0;
  }
  .field legend {
    margin-bottom: var(--s-2);
  }
  .opt {
    font-weight: 400;
    color: var(--text-faint);
  }
  .field input:not([type='radio']) {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border: 0;
    border-radius: var(--r-md);
    background: var(--fill);
    box-shadow: inset 0 0 0 1px var(--field-border);
    font-size: 1rem;
    transition:
      box-shadow 0.2s,
      background-color 0.2s;
  }
  .field input:not([type='radio']):focus {
    outline: none;
    background: var(--fill-strong);
    box-shadow:
      inset 0 0 0 2px var(--accent-graphic),
      0 0 0 4px rgba(14, 159, 110, 0.18);
  }
  .field input[aria-invalid='true'] {
    box-shadow: inset 0 0 0 2px var(--danger) !important;
  }
  .field__phone {
    display: flex;
    align-items: stretch;
  }
  .field__phone span {
    display: grid;
    place-items: center;
    padding: 0 14px;
    border-radius: var(--r-md) 0 0 var(--r-md);
    background: var(--fill-strong);
    box-shadow: inset 0 0 0 1px var(--field-border);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .field__phone input {
    border-radius: 0 var(--r-md) var(--r-md) 0 !important;
  }
  .field__hint {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .field__err {
    font-size: 0.85rem;
    color: var(--danger);
  }
  .field__err:empty {
    display: none;
  }

  .pains {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .pain {
    position: relative;
    cursor: pointer;
  }
  .pain input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .pain span {
    display: block;
    padding: 9px 14px;
    border-radius: var(--r-full);
    box-shadow: inset 0 0 0 1px var(--field-border);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .pain:hover span {
    background: var(--fill);
  }
  .pain input:checked + span {
    background: var(--green);
    color: var(--black);
    box-shadow: none;
    font-weight: 600;
  }
  .pain input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }
  .beta__card .btn {
    margin-top: var(--s-2);
  }
  .beta__card .btn--primary {
    box-shadow: 0 0 40px 4px var(--fill-strong);
  }
  .beta__card .btn[disabled] {
    opacity: 0.75;
    cursor: progress;
  }
  /* Enviando: un círculo que gira junto al texto */
  .beta__card .btn[data-loading]::before {
    content: '';
    width: 1em;
    height: 1em;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-right-color: transparent;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  .beta__fine {
    font-size: 0.8rem;
    color: var(--text-faint);
    text-align: center;
  }
  .beta__status:empty {
    display: none;
  }
  .beta__status {
    padding: 14px 16px;
    border-radius: var(--r-md);
    background: var(--danger-soft);
    color: var(--danger);
    font-size: 0.95rem;
  }
  /* Aviso que no es error (ej. "Un momento…") */
  .beta__status[data-tone='info'] {
    background: var(--fill);
    color: var(--text-muted);
  }

  /* "Registro completado": modal centrado, con fondo oscurecido */
  .beta-modal {
    width: min(520px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: clamp(28px, 5vw, 44px) clamp(20px, 4vw, 36px);
    border: 0;
    border-radius: var(--r-xxl);
    background: var(--bg-alt);
    color: var(--text);
    box-shadow:
      inset 0 0 0 1px var(--hairline-strong),
      0 30px 90px var(--shadow);
    text-align: center;
    overflow: auto;
  }
  .beta-modal[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    animation: modal-in 0.4s var(--ease-out);
  }
  .beta-modal::backdrop {
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: fade-in 0.3s ease-out;
  }
  .beta-modal__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .beta-modal__text {
    color: var(--text-muted);
    max-width: 30ch;
  }
  .beta-modal :global(.beta__share) {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--s-2);
    padding-top: var(--s-5);
    border-top: 1px solid var(--hairline);
    width: 100%;
  }
  .beta-modal :global(.beta__share ul) {
    justify-content: center;
  }
  .beta-modal__actions {
    width: 100%;
    margin-top: var(--s-2);
  }
  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  .beta__check svg {
    fill: none;
    stroke: var(--accent-graphic);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .beta__check circle {
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: draw 0.8s 0.15s var(--ease-out) forwards;
  }
  .beta__check path {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: draw 0.5s 0.75s var(--ease-out) forwards;
  }
  /* El círculo se llena de verde suave y el check "salta" al terminar de dibujarse */
  .beta__check {
    display: grid;
    place-items: center;
    border-radius: 50%;
    animation: pop 0.45s 1.15s var(--ease-out) both;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pop {
    0% {
      transform: scale(1);
      background: transparent;
    }
    50% {
      transform: scale(1.1);
    }
    100% {
      transform: scale(1);
      background: var(--check-bg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .beta-modal[open],
    .beta-modal::backdrop,
    .beta__check,
    .beta__check circle,
    .beta__check path,
    .beta__card .btn[data-loading]::before {
      animation: none;
    }
    .beta__check circle,
    .beta__check path {
      stroke-dashoffset: 0;
    }
    .beta__check {
      background: var(--check-bg);
    }
  }

  @media (max-width: 991px) {
    .beta__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
