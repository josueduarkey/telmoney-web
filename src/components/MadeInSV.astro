---
import type { ImageMetadata } from 'astro';
import Sticker from './Sticker.astro';

// Logos ya normalizados por scripts/bancos.mjs (una sola tinta, sin aire, mismo alto).
// Se pintan con el color del texto vía máscara, así siguen el tema claro u oscuro.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/bancos/*.png', { eager: true });

// `scale` corrige a ojo los que pesan más que el resto (letras muy gruesas).
const institutions = [
  { name: 'Banco Agrícola', slug: 'agricola' },
  { name: 'BAC Credomatic', slug: 'bac' },
  { name: 'Banco Cuscatlán', slug: 'cuscatlan' },
  { name: 'Davivienda', slug: 'davivienda' },
  { name: 'Banco Promerica', slug: 'promerica' },
  { name: 'Banco Hipotecario', slug: 'hipotecario' },
  { name: 'n1co', slug: 'n1co', scale: 0.85 },
  { name: 'Multimoney', slug: 'multimoney' },
  { name: 'Banco Azul', slug: 'azul' },
  { name: 'Fedecrédito', slug: 'fedecredito' },
].map(({ name, slug, scale = 1 }) => {
  const { src, width, height } = files[`../assets/bancos/${slug}.png`].default;
  const ratio = width / height;
  // Mismo "peso" para todos: a igual área, los anchos salen más bajos y los compactos más altos.
  const k = Math.sqrt(3.2 / ratio) * scale;
  return { name, style: `--logo:url(${src});--r:${ratio.toFixed(3)};--k:${k.toFixed(3)}` };
});
// Cuatro vueltas de la lista: la animación recorre la mitad y así no queda hueco ni en pantallas muy anchas.
const reel = Array.from({ length: 4 }, () => institutions).flat();
const phrases = [
  '"gasté 3.50 en el almuerzo"',
  '"me cayó la quincena"',
  '"12 de gasolina con la tarjeta"',
  '"12.50 me dio mi mamá"',
  '"pasé 50 del agrícola a n1co"',
  '"le di 20 a Chepe"',
  '"eso fue antier"',
];
const facts = [
  { t: 'Al centavo', d: 'Cada saldo cuadra, cuenta por cuenta.' },
  { t: 'Al ritmo de tu pago', d: 'Cuenta los días hasta tu próximo ingreso, sea quincena o fin de mes.' },
  { t: 'Tus bancos y billeteras', d: 'Sabe que "BAC" y "credomatic" son la misma cuenta.' },
  { t: 'Sin aprender nada', d: 'Si sabes mandar un audio, ya sabes usar TelMoney.' },
];
---

<section class="sv band" id="el-salvador" aria-labelledby="sv-title">
  <Sticker kind="piggy" size={140} class="sv__piggy" data-float="1" />

  <div class="container">
    <h2 class="display sv__title" id="sv-title">Entiende cómo hablas<span class="pd">.</span> <br />Conoce tus bancos<span class="pd">.</span></h2>
    <p class="sv__note">Empezamos en El Salvador.</p>
  </div>

  <div class="marquee marquee--logos" aria-label="Bancos y billeteras que reconoce">
    <ul class="marquee__track" role="list">
      {
        reel.map((n, i) => (
          <li aria-hidden={i >= institutions.length ? 'true' : undefined}>
            <span class="bank" role="img" aria-label={n.name} style={n.style} />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="marquee marquee--reverse marquee--phrases" aria-label="Frases que entiende">
    <ul class="marquee__track" role="list">
      {[...phrases, ...phrases].map((n, i) => <li aria-hidden={i >= phrases.length ? 'true' : undefined}>{n}</li>)}
    </ul>
  </div>

  <div class="container">
    <ul class="sv__facts" role="list">
      {
        facts.map((f) => (
          <li>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sv {
    background:
      radial-gradient(60% 80% at 100% 0%, var(--band-glow), transparent 70%),
      var(--band);
    color: var(--text);
    overflow: clip;
    isolation: isolate;
  }
  .sv :global(.sv__piggy) {
    right: 8%;
    top: -64px;
    rotate: 10deg;
  }
  .sv__note {
    margin-top: var(--s-4);
    color: var(--text-muted);
  }
  .sv__title {
    font-size: clamp(2.6rem, 6.4vw, 5.6rem);
    max-width: 12em;
  }

  .marquee {
    --dur: 40s;
    margin-top: var(--s-7);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    gap: var(--s-7);
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee var(--dur) linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee li {
    white-space: nowrap;
  }
  .marquee--logos {
    --logo-h: clamp(1.75rem, 3.2vw, 2.5rem);
  }
  .marquee--logos .marquee__track {
    align-items: center;
    min-height: calc(var(--logo-h) * 1.4);
  }
  .bank {
    display: block;
    height: calc(var(--logo-h) * var(--k));
    width: calc(var(--logo-h) * var(--k) * var(--r));
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .marquee--reverse .marquee__track {
    animation-direction: reverse;
  }
  .marquee--phrases {
    --dur: 55s;
    margin-top: clamp(var(--s-6), 4vw, var(--s-8));
  }
  .marquee--phrases li {
    font-family: var(--font-ui);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 600;
    letter-spacing: 0;
    padding: 10px 18px;
    border-radius: var(--r-full);
    background: var(--black);
    color: var(--white);
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - var(--s-7) / 2));
    }
  }

  .sv__facts {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
  }
  .sv__facts li {
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline-strong);
  }
  .sv__facts h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    margin-bottom: var(--s-2);
  }
  .sv__facts p {
    color: var(--text-muted);
  }

  @media (max-width: 991px) {
    .sv__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 575px) {
    .sv__facts {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      flex-wrap: wrap;
      width: auto;
      animation: none;
    }
    .marquee li[aria-hidden='true'] {
      display: none;
    }
  }
</style>
