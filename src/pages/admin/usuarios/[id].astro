---
// Una persona: su actividad, lo que le cuesta a TelMoney, datos de cuenta y pagos.
import CostBreakdown from '../../../components/admin/CostBreakdown.astro';
import Admin from '../../../layouts/Admin.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import DailyColumns from '../../../components/admin/DailyColumns.astro';
import DbError from '../../../components/admin/DbError.astro';
import { messagesPerDay, user, userSavings } from '../../../lib/admin/queries';
import { ago, date, dateTime, int, phone, planName, usd, usdCost, waLink } from '../../../lib/admin/format';

export const prerender = false;

// Segunda llave (la primera es src/middleware.ts): sin sesión de admin no se consulta nada.
if (!Astro.locals.admin) return new Response('No autorizado', { status: 401 });

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/admin/usuarios');

let data: [Awaited<ReturnType<typeof user>>, Awaited<ReturnType<typeof messagesPerDay>>] | null = null;
let error = '';
let ahorro: Awaited<ReturnType<typeof userSavings>> = null;
try {
  data = await Promise.all([user(id), messagesPerDay(30, id)]);
  ahorro = await userSavings(id);
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
const [detail, perDay] = data ?? [];
if (data && !detail) {
  Astro.response.status = 404;
}
const u = detail?.user;
const t = detail?.totals;

const PAYMENT: Record<string, string> = { approved: 'Aprobado', pending: 'Pendiente', failed: 'Falló' };
---

<Admin title={u?.name || 'Usuario'} section="usuarios">
  <a class="admin-back" href="/admin/usuarios">← Usuarios</a>
  {error && <DbError error={error} />}
  {data && !detail && <div class="notice"><h1>No existe ese usuario</h1><p>Puede que haya borrado sus datos.</p></div>}
  {
    u && t && perDay && (
      <>
        <div class="admin-head">
          <div>
            <h1>{u.name || 'Sin nombre'}</h1>
            <p>
              {u.whatsapp_number ? (
                <a href={waLink(u.whatsapp_number)} target="_blank" rel="noopener">
                  {phone(u.whatsapp_number)}
                </a>
              ) : (
                'Telegram'
              )}{' '}
              · desde el {date(u.created_at)} · última vez {ago(u.last_inbound_at)}
            </p>
          </div>
          <StatusChip status={u.status} />
        </div>

        <div class="cards">
          <div class="card">
            <p class="stat__label">Movimientos</p>
            <p class="stat__value">{int(t.movements)}</p>
            <p class="stat__note">
              registrados desde que empezó
            </p>
          </div>
          <div class="card">
            <p class="stat__label">Mensajes (30 días)</p>
            <p class="stat__value">{int(t.msgs_in)}</p>
            <p class="stat__note">
              <b>{int(t.msgs_out + t.jobs_sent)}</b> del bot
            </p>
          </div>
          <div class="card">
            <p class="stat__label">Costo estimado (30 días)</p>
            <p class="stat__value">{usdCost(t.cost.total)}</p>
            <p class="stat__note">
              Meta <b>{usdCost(t.cost.meta.usd)}</b> · Gemini <b>{usdCost(t.cost.gemini.usd)}</b>
            </p>
          </div>
          <div class="card">
            <p class="stat__label">Pagó en total</p>
            <p class="stat__value">{usd(t.paid_total)}</p>
            <p class="stat__note">
              {planName(u.plan)}
              {ahorro && ahorro.total > 0 && (
                <>
                  {' '}· le ahorramos <b>{usd(ahorro.total)}</b>
                </>
              )}
            </p>
          </div>
        </div>

        <div class="section">
          <CostBreakdown cost={t.cost} title="Lo que cuesta atenderlo" sub="Últimos 30 días" />
        </div>

        <div class="grid-2">
          <section class="card" aria-labelledby="t-msgs">
            <div class="card__head">
              <h2 id="t-msgs">Mensajes por día</h2>
              <p class="card__sub">Últimos 30 días</p>
            </div>
            <DailyColumns data={perDay} unit="mensajes" />
          </section>

          <section class="card" aria-labelledby="t-data">
            <div class="card__head">
              <h2 id="t-data">Datos de la cuenta</h2>
              <p class="card__sub">Información técnica y plan</p>
            </div>
            <dl class="kv">
              <dt>Canal</dt>
              <dd>{u.whatsapp_number ? `WhatsApp (${phone(u.whatsapp_number)})` : 'Telegram'}</dd>
              <dt>Plan actual</dt>
              <dd>{planName(u.plan)}</dd>
              <dt>Prueba hasta</dt>
              <dd>{date(u.trial_ends_at)}</dd>
              <dt>Pagado hasta</dt>
              <dd>{date(u.paid_until)}</dd>
              <dt>Terminó configuración</dt>
              <dd>{u.onboarded_at ? date(u.onboarded_at) : 'No'}</dd>
              <dt>Zona horaria</dt>
              <dd>{u.timezone || 'America/El_Salvador'}</dd>
            </dl>
          </section>
        </div>

        <section class="section" aria-labelledby="t-pay">
          <div class="card__head">
            <h2 id="t-pay" class="section-title">Pagos</h2>
          </div>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Plan</th>
                  <th class="r">Monto</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                {detail.payments.map((p) => (
                  <tr>
                    <td class="nowrap muted">{dateTime(p.approved_at ?? p.created_at)}</td>
                    <td>{planName(p.plan)}</td>
                    <td class="r">{usd(p.amount)}</td>
                    <td>{PAYMENT[p.status] ?? p.status}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {!detail.payments.length && <p class="empty">No ha pagado.</p>}
          </div>
        </section>
      </>
    )
  }
</Admin>
