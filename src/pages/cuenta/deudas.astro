---
// Deudas: quién le debe (y cuánto falta) y a quién le debe; anotar una, abonar y saldar. Abonar y saldar
// mueven el dinero en la cuenta que elija, igual que por WhatsApp. Lee /me/deudas.
import Cuenta from '../../layouts/Cuenta.astro';
import Head from '../../components/cuenta/Head.astro';
import Flash from '../../components/cuenta/Flash.astro';
import Dialog from '../../components/cuenta/Dialog.astro';
import Icon from '../../components/cuenta/Icon.astro';
import Pronto from '../../components/cuenta/Pronto.astro';
import Pide from '../../components/cuenta/Pide.astro';
import { me, pendiente, sinVincular, type Deuda, type Deudas } from '../../lib/admin/bot';
import { opciones, sesion } from '../../lib/cuenta/pagina';
import { dinero, ejecutar, idDe, texto } from '../../lib/cuenta/acciones';
import { date, usd } from '../../lib/admin/format';

export const prerender = false;

const ses = await sesion(Astro);
if ('salir' in ses) return ses.salir;
const { token } = ses;

if (Astro.request.method === 'POST') {
  return ejecutar(Astro, token, (accion, f) => {
    const id = idDe(f.get('id'));
    const cuenta_id = idDe(f.get('cuenta_id')) ? Number(f.get('cuenta_id')) : undefined;
    if (accion === 'crear') {
      const direccion = texto(f.get('direccion'));
      const persona = texto(f.get('persona')).slice(0, 60);
      const monto = dinero(f.get('monto'));
      if (direccion !== 'me_deben' && direccion !== 'debo') return 'Elige si te deben o si debes.';
      if (!persona) return 'Escribe con quién es la deuda.';
      if (!monto || monto <= 0) return 'Escribe un monto mayor que cero.';
      const body = { direccion, persona, monto, descripcion: texto(f.get('descripcion')).slice(0, 120) || undefined, vence: texto(f.get('vence')) || undefined };
      return { path: '/me/deudas', method: 'POST', body, ok: `Anotado: ${persona}, ${usd(monto)}.` };
    }
    if (!id) return 'No encontramos esa deuda.';
    if (accion === 'abonar') {
      const monto = dinero(f.get('monto'));
      if (!monto || monto <= 0) return 'Escribe un monto mayor que cero.';
      return { path: `/me/deudas/${id}/abono`, method: 'POST', body: { monto, cuenta_id }, ok: `Abono de ${usd(monto)} anotado.` };
    }
    if (accion === 'saldar') return { path: `/me/deudas/${id}/saldar`, method: 'POST', body: { cuenta_id }, ok: 'Deuda saldada.' };
    return 'Acción no válida.';
  });
}

const [r, ops] = await Promise.all([me<Deudas>('/me/deudas', token), opciones(token, { categorias: false })]);
if (sinVincular(r)) return Astro.redirect('/cuenta');
const d = r.ok ? r.data : null;
const { cuentas } = ops;
const total = (l: Deuda[]) => l.reduce((s, x) => s + x.pendiente, 0);
const hoy = new Date().toISOString().slice(0, 10);
const grupos = d
  ? [
      { titulo: 'Te deben', vacio: 'Nadie te debe nada.', lista: d.me_deben ?? [], recibe: true },
      { titulo: 'Debes', vacio: 'No le debes a nadie.', lista: d.debo ?? [], recibe: false },
    ]
  : [];
---

<Cuenta title="Deudas" section="deudas">
  <Head titulo="Deudas" sub="Lo que te deben y lo que debes, con lo que ya se abonó.">
    {
      d && (
        <button class="act act--main" type="button" data-dialog="dlg-deuda">
          <Icon name="mas" size={16} /> Anotar deuda
        </button>
      )
    }
  </Head>
  <Flash />

  {
    pendiente(r) && (
      <Pronto
        icon="deudas"
        titulo="Tus deudas van a aparecer aquí"
        texto="Quién te debe, cuánto falta y para cuándo; y lo que tú debes. Estamos conectándolo con TelMoney."
        frases={['¿quién me debe?', 'Juan me debe 20 para el viernes', 'le pagué 50 a la financiera']}
      />
    )
  }
  {!r.ok && !pendiente(r) && <p class="flash flash--error">{r.detail}</p>}

  {
    d && (
      <>
        <div class="cards">
          <div class="card">
            <p class="stat__label">Te deben</p>
            <p class="stat__value">{usd(total(d.me_deben ?? []))}</p>
            <p class="stat__note">{(d.me_deben ?? []).length} personas</p>
          </div>
          <div class="card">
            <p class="stat__label">Debes</p>
            <p class="stat__value">{usd(total(d.debo ?? []))}</p>
            <p class="stat__note">{(d.debo ?? []).length} deudas abiertas</p>
          </div>
        </div>

        {grupos.map((g) => (
          <section class="section">
            <h2 class="section-title">{g.titulo}</h2>
            {g.lista.length ? (
              <div class="mod-grid" style="margin-top: var(--s-3)">
                {g.lista.map((x) => {
                  const pct = x.monto ? Math.min(100, (x.abonado / x.monto) * 100) : 0;
                  const vencida = x.vence && x.vence < hoy;
                  return (
                    <article class="card tile">
                      <div class="tile__top">
                        <div>
                          <p class="tile__name">{x.persona}</p>
                          <p class="tile__meta">{x.descripcion || `Desde el ${date(x.creada)}`}</p>
                        </div>
                        {x.vence && (
                          <span class:list={['badge', { 'badge--danger': vencida }]}>
                            {vencida ? 'Venció' : 'Vence'} {date(x.vence)}
                          </span>
                        )}
                      </div>
                      <p class="tile__amount">{usd(x.pendiente)}</p>
                      <div class="progress">
                        <span style={`width:${pct.toFixed(1)}%`} />
                      </div>
                      <div class="row-split">
                        <span>abonado {usd(x.abonado)}</span>
                        <span>de {usd(x.monto)}</span>
                      </div>
                      <div class="acts">
                        <button class="act act--main" type="button" data-dialog="dlg-abono" data-accion="abonar"
                          data-title={g.recibe ? `${x.persona} te abonó` : `Le abonaste a ${x.persona}`}
                          data-values={JSON.stringify({ id: x.id })}>
                          Abonar
                        </button>
                        <button class="act" type="button" data-dialog="dlg-saldar"
                          data-title={g.recibe ? `${x.persona} te pagó todo` : `Le pagaste todo a ${x.persona}`}
                          data-values={JSON.stringify({ id: x.id })}>
                          Saldar {usd(x.pendiente)}
                        </button>
                      </div>
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="card empty" style="margin-top: var(--s-3)">{g.vacio}</p>
            )}
          </section>
        ))}
        <Pide frases={['Juan me debe 20 para el viernes', 'Juan me abonó 10', 'recuérdale a Juan']} />

        <Dialog id="dlg-deuda" titulo="Anotar deuda" accion="crear">
          <div class="fld">
            ¿Quién le debe a quién?
            <div class="seg" role="radiogroup">
              <label class="seg__opt"><input type="radio" name="direccion" value="me_deben" checked /> Me deben</label>
              <label class="seg__opt"><input type="radio" name="direccion" value="debo" /> Debo</label>
            </div>
          </div>
          <div class="fld-row">
            <label class="fld">
              Persona
              <input class="field" name="persona" required maxlength="60" placeholder="Juan" />
            </label>
            <label class="fld">
              Monto
              <input class="field" name="monto" inputmode="decimal" required placeholder="20" />
            </label>
          </div>
          <label class="fld">
            Para qué <small>(opcional)</small>
            <input class="field" name="descripcion" maxlength="120" placeholder="El almuerzo del viernes" />
          </label>
          <label class="fld">
            Para cuándo <small>(opcional)</small>
            <input class="field" name="vence" type="date" />
          </label>
        </Dialog>

        {[
          { id: 'dlg-abono', titulo: 'Abonar', accion: 'abonar', monto: true },
          { id: 'dlg-saldar', titulo: 'Saldar', accion: 'saldar', monto: false },
        ].map((x) => (
          <Dialog id={x.id} titulo={x.titulo} accion={x.accion} enviar={x.monto ? 'Abonar' : 'Saldar'}>
            {x.monto && (
              <label class="fld">
                Monto
                <input class="field" name="monto" inputmode="decimal" required placeholder="10" />
              </label>
            )}
            <label class="fld">
              ¿En qué cuenta? <small>(de ahí sale o ahí llega)</small>
              <select class="field" name="cuenta_id">
                <option value="">La de siempre</option>
                {cuentas.map((c) => <option value={c.id}>{c.nombre}</option>)}
              </select>
            </label>
          </Dialog>
        ))}
      </>
    )
  }
</Cuenta>

<style>
  .seg__opt {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--r-full);
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--text-muted);
    cursor: pointer;
  }
  .seg__opt:has(input:checked) {
    background: var(--fill-strong);
    color: var(--text);
  }
  .seg__opt input {
    accent-color: var(--accent);
  }
</style>
