---
// Ajustes: cómo lo llama TelMoney. Lo que le entra y lo que aparta ya no se escribe aquí: sale de sus
// fuentes de ingreso (/cuenta/ingresos) y sus apartados (/cuenta/apartados), y aquí solo se resume.
// Lee y guarda /me/perfil.
import Cuenta from '../../layouts/Cuenta.astro';
import Head from '../../components/cuenta/Head.astro';
import Flash from '../../components/cuenta/Flash.astro';
import Pronto from '../../components/cuenta/Pronto.astro';
import { me, pendiente, sinVincular, type Perfil } from '../../lib/admin/bot';
import { sesion } from '../../lib/cuenta/pagina';
import { ejecutar, texto } from '../../lib/cuenta/acciones';
import { usd } from '../../lib/admin/format';

export const prerender = false;

const ses = await sesion(Astro);
if ('salir' in ses) return ses.salir;
const { token } = ses;

if (Astro.request.method === 'POST') {
  return ejecutar(Astro, token, (accion, f) => {
    if (accion !== 'guardar') return 'Acción no válida.';
    const nombre = texto(f.get('nombre')).slice(0, 40);
    if (!nombre) return 'Escribe cómo quieres que te llame.';
    return { path: '/me/perfil', method: 'PATCH', body: { nombre }, ok: 'Listo.' };
  });
}

const r = await me<{ perfil: Perfil }>('/me/perfil', token);
if (sinVincular(r)) return Astro.redirect('/cuenta');
const p = r.ok ? (r.data?.perfil ?? null) : null;
---

<Cuenta title="Ajustes" section="ajustes">
  <Head titulo="Ajustes" sub="Cómo te llama TelMoney y de dónde sale tu número del día." />
  <Flash />

  {
    pendiente(r) && (
      <Pronto
        icon="ajustes"
        titulo="Tus ajustes van a aparecer aquí"
        texto="Tu nombre y un resumen de tus ingresos y apartados. Estamos conectándolo con TelMoney."
        frases={['llámame Ana', 'mis ingresos', 'mis apartados']}
      />
    )
  }
  {!r.ok && !pendiente(r) && <p class="flash flash--error">{r.detail}</p>}

  {
    p && (
      <div class="ajustes">
        <form class="card ajustes__form" method="post">
          <input type="hidden" name="accion" value="guardar" />
          <label class="fld">
            Cómo te llamo
            <input class="field" name="nombre" required maxlength="40" value={p.nombre ?? ''} />
          </label>
          <div class="acts">
            <button class="btn btn--primary" type="submit">Guardar</button>
          </div>
        </form>

        <div class="mod-grid">
          <a class="card tile tile--link" href="/cuenta/ingresos">
            <p class="tile__name">Ingresos</p>
            <p class="tile__amount">{p.ingreso_mensual ? usd(p.ingreso_mensual) : '—'}<small class="muted"> al mes</small></p>
            <p class="tile__meta">De dónde te entra dinero y cada cuánto. Con esto se calcula cuánto puedes gastar al día.</p>
          </a>
          <a class="card tile tile--link" href="/cuenta/apartados">
            <p class="tile__name">Apartados (%)</p>
            <p class="tile__meta">El porcentaje de lo que te entra que separas para ahorro u otra cosa que tú elijas.</p>
          </a>
        </div>
        {p.cuenta_cobro && <p class="stat__note">Tu dinero entra en: <b>{p.cuenta_cobro}</b></p>}
      </div>
    )
  }
</Cuenta>

<style>
  .ajustes {
    display: grid;
    gap: var(--s-4);
    max-width: 720px;
  }
  .ajustes__form {
    display: grid;
    gap: var(--s-4);
  }
  .tile--link {
    color: inherit;
    text-decoration: none;
  }
  .tile--link:hover {
    border-color: var(--accent);
  }
</style>
