---
// Ajustes y plan, en una sola página: cómo lo llama TelMoney (/me/perfil), su plan (cuál tiene, cuándo
// vence, pagar o renovar con Wompi, lo arma el bot), sus pagos y su WhatsApp conectado (/me).
// Lo que recibe y lo que aparta no se escribe aquí: sale de /cuenta/ingresos y /cuenta/apartados.
// Los pagos son de una vez (no se cobran solos): al vencer, se renueva desde aquí o por WhatsApp.
// /cuenta/plan (los enlaces viejos y la vuelta de Wompi) redirige a esta página.
import Cuenta from '../../layouts/Cuenta.astro';
import Head from '../../components/cuenta/Head.astro';
import Flash from '../../components/cuenta/Flash.astro';
import { me, sinVincular, type Me, type Pago, type Perfil } from '../../lib/admin/bot';
import { sesion } from '../../lib/cuenta/pagina';
import { planLabel } from '../../lib/cuenta/session';
import { ejecutar, texto } from '../../lib/cuenta/acciones';
import { date, dateTime, phone, usd } from '../../lib/admin/format';
import { PLANS } from '../../config';

export const prerender = false;

const ses = await sesion(Astro);
if ('salir' in ses) return ses.salir;
const { token } = ses;

let error = '';
if (Astro.request.method === 'POST') {
  const accion = texto((await Astro.request.clone().formData()).get('accion'));
  if (accion === 'guardar') {
    return ejecutar(Astro, token, (_, f) => {
      const nombre = texto(f.get('nombre')).slice(0, 40);
      if (!nombre) return 'Escribe cómo quieres que te llame.';
      return { path: '/me/perfil', method: 'PATCH', body: { nombre }, ok: 'Listo.' };
    });
  }
  const f = await Astro.request.formData();
  if (accion === 'desvincular') {
    const r = await me('/me/vincular', token, { method: 'DELETE' });
    if (r.ok) return Astro.redirect('/cuenta', 303);
    error = r.detail;
  } else if (accion === 'pagar') {
    // El bot crea el enlace de Wompi y se manda a la persona ahí.
    const r = await me<{ checkout_url: string }>('/me/pagar', token, {
      method: 'POST',
      body: { plan: String(f.get('plan') ?? '') },
    });
    // Solo se redirige a un enlace https: nunca a otra cosa que devuelva la API.
    if (r.ok && r.data?.checkout_url && /^https:\/\//.test(r.data.checkout_url)) return Astro.redirect(r.data.checkout_url, 303);
    error = r.ok ? 'No pudimos crear el enlace de pago.' : r.detail;
  } else {
    error = 'Acción no válida.';
  }
}

const [perfil, rp] = await Promise.all([me<Me>('/me', token), me<{ perfil: Perfil }>('/me/perfil', token)]);
if ((perfil.ok && !perfil.data.vinculado) || sinVincular(rp)) return Astro.redirect('/cuenta');
const datos = perfil.ok && perfil.data.vinculado ? perfil.data : null;
const p = rp.ok ? (rp.data?.perfil ?? null) : null;
const pagos = datos ? await me<{ pagos: Pago[] }>('/me/pagos', token) : null;
const pagoListo = Astro.url.searchParams.get('pago') === 'listo';

const ESTADO = { prueba: 'En prueba', pagando: 'Activo', gratis: 'Gratis, con límite diario', vencido: 'Vencido', equipo: 'Equipo' } as const;
const PAGO = { approved: 'Aprobado', pending: 'Pendiente', failed: 'No se completó' } as const;
const vence = datos ? (datos.plan.estado === 'prueba' ? datos.plan.prueba_hasta : datos.plan.pagado_hasta) : null;
const BENEFICIOS: Record<string, string[]> = {
  starter: ['Hasta 30 mensajes al día', 'Cuentas, metas, límites y deudas', 'Reporte de cada noche', '5 preguntas libres al día'],
  pro: [`Todo lo de ${PLANS.starter.name}, sin tope diario`, 'Avisos antes de cada pago fijo y de tu tarjeta', 'Cobros a quien te debe', 'Preguntas sin límite', 'Excel, PDF y gráficas'],
};
const nivelDe = (plan: string) => (plan.startsWith('starter') ? 'starter' : 'pro');
---

<Cuenta title="Ajustes y plan" section="ajustes">
  <Head titulo="Ajustes y plan" sub="Cómo te llama TelMoney, tu plan y tu WhatsApp. El plan se paga una vez por mes o por año, con Wompi: no se cobra solo." />
  <Flash />

  {pagoListo && (
    <p class="flash flash--ok" role="alert">
      ¡Gracias por tu pago! En cuanto Wompi lo confirme, tu plan se actualizará aquí y TelMoney te avisará por WhatsApp.
    </p>
  )}
  {error && <p class="flash flash--error" role="alert">{error}</p>}
  {!perfil.ok && <p class="flash flash--error">{perfil.detail}</p>}

  {
    p && (
      <section class="section ajustes" aria-labelledby="t-perfil">
        <h2 id="t-perfil" class="section-title card__head">Tú</h2>
        <form class="card ajustes__form" method="post">
          <input type="hidden" name="accion" value="guardar" />
          <label class="fld">
            Cómo te llamo
            <input class="field" name="nombre" required maxlength="40" value={p.nombre ?? ''} />
          </label>
          <div class="acts">
            <button class="btn btn--primary" type="submit">Guardar</button>
          </div>
        </form>
        <p class="stat__note">
          Lo que recibes y lo que apartas está en <a href="/cuenta/ingresos">Ingresos</a>
          {p.ingreso_mensual ? <> ({usd(p.ingreso_mensual)} al mes)</> : null} y en <a href="/cuenta/apartados">Apartados</a>.
          {p.cuenta_cobro && <> Tu dinero llega a <b>{p.cuenta_cobro}</b>.</>}
        </p>
      </section>
    )
  }

  {
    datos && (
      <>
        <section class="section" id="plan" aria-labelledby="t-plan">
          <h2 id="t-plan" class="section-title card__head">Tu plan</h2>
          <div class="cards">
            <div class="card">
              <p class="stat__label">Plan</p>
              <p class="stat__value">{planLabel(datos.plan.plan, datos.plan.nivel)}</p>
              <p class="stat__note">{ESTADO[datos.plan.estado]}</p>
            </div>
            {datos.plan.estado !== 'gratis' && (
              <div class="card">
                <p class="stat__label">{datos.plan.estado === 'prueba' ? 'La prueba termina' : 'Vence'}</p>
                <p class="stat__value">{vence ? date(vence) : '—'}</p>
                <p class="stat__note">{datos.plan.renovacion_automatica ? 'Se renueva solo' : 'No se cobra solo'}</p>
              </div>
            )}
          </div>

          <h3 class="ajustes__sub">{datos.plan.estado === 'pagando' ? 'Renovar o cambiar de plan' : 'Elige tu plan'}</h3>
          <div class="plans">
            {(datos.precios ?? []).filter((x) => x.monto > 0).map((x) => (
              <form method="post" class:list={['card', 'plan-card', { 'plan-card--pro': nivelDe(x.plan) === 'pro' }]}>
                <input type="hidden" name="accion" value="pagar" />
                <input type="hidden" name="plan" value={x.plan} />
                <h3>{x.nombre}</h3>
                <p class="plan-card__price">
                  {usd(x.monto)} <span>/ {x.periodo}</span>
                </p>
                <ul>
                  {(BENEFICIOS[nivelDe(x.plan)] ?? []).map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <button class="btn-quiet btn-main" type="submit">
                  Pagar {usd(x.monto)} con Wompi
                </button>
              </form>
            ))}
          </div>
          {(!datos.precios || !datos.precios.length) && (
            <p class="empty" style="margin-top: var(--s-3)">Los planes se están actualizando. Puedes consultar tu plan o pagar escribiéndole a TelMoney por WhatsApp.</p>
          )}
          <p class="note">Te llevamos a Wompi para pagar con tarjeta. Al terminar, TelMoney te avisa por WhatsApp.</p>
        </section>

        <section class="section" aria-labelledby="t-pagos">
          <h2 id="t-pagos" class="section-title card__head">Tus pagos</h2>
          <div class="table-wrap">
            <table class="table">
              <tbody>
                {pagos?.ok &&
                  (pagos.data?.pagos ?? []).map((x) => (
                    <tr>
                      <td class="nowrap muted">{dateTime(x.fecha)}</td>
                      <td>{planLabel(x.plan, null)}</td>
                      <td>{PAGO[x.estado] ?? x.estado}</td>
                      <td class="r">{usd(x.monto)}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
            {pagos?.ok && !(pagos.data?.pagos?.length) && <p class="empty">Todavía no has pagado.</p>}
            {pagos && !pagos.ok && <p class="empty">{pagos.detail}</p>}
          </div>
        </section>

        <section class="section card" aria-labelledby="t-wa">
          <h2 id="t-wa" class="card__head">Tu WhatsApp</h2>
          <p>Conectado: {phone(datos.usuario.whatsapp)}</p>
          <details class="ia-delete" style="margin-top: var(--s-3)">
            <summary class="btn-quiet">Desconectar</summary>
            <form method="post">
              <input type="hidden" name="accion" value="desvincular" />
              <span>Tu WhatsApp y tus datos siguen en TelMoney; solo esta cuenta deja de verlos.</span>
              <button class="btn-quiet btn-danger" type="submit">Sí, desconectar</button>
            </form>
          </details>
        </section>
      </>
    )
  }
</Cuenta>

<style>
  .ajustes {
    display: grid;
    gap: var(--s-3);
    max-width: 720px;
  }
  .ajustes__form {
    display: grid;
    gap: var(--s-4);
  }
  .ajustes__sub {
    margin: var(--s-5) 0 var(--s-3);
    font-size: 1rem;
  }
  .plans {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .plan-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .plan-card h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
  }
  .plan-card--pro {
    box-shadow: inset 0 0 0 1px var(--accent-graphic);
  }
  .plan-card__price {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .plan-card__price span {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-muted);
  }
  .plan-card ul {
    margin: 0;
    padding-left: 1.1em;
    color: var(--text-muted);
    font-size: var(--fs-small);
    display: grid;
    gap: 4px;
    flex: 1;
  }
  .plan-card .btn-quiet {
    justify-content: center;
  }
</style>
