---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Today from '../components/Today.astro';
import Features from '../components/Features.astro';
import MadeInSV from '../components/MadeInSV.astro';
import Privacy from '../components/Privacy.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';
---

<Base>
