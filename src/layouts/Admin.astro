---
// Marco del panel de administración (/admin). Fuera de Google (noindex, y robots.txt no lo lista),
// sin la animación ni el cursor de la página pública. Respeta el tema elegido en la página.
import '../styles/global.css';
import '../styles/admin.css';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  /** Sección activa del menú. */
  section?: 'resumen' | 'usuarios' | 'interesados' | 'funciones' | 'ia';
}
const { title, section } = Astro.props;
const admin = Astro.locals.admin;

const nav = [
  { id: 'resumen', label: 'Resumen', href: '/admin' },
  { id: 'usuarios', label: 'Usuarios', href: '/admin/usuarios' },
  { id: 'interesados', label: 'Interesados', href: '/admin/interesados' },
  { id: 'funciones', label: 'Funciones', href: '/admin/funciones' },
  { id: 'ia', label: 'IA', href: '/admin/ia' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <title>{`${title} · Panel TelMoney`}</title>
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('tm-theme');
        } catch (e) {}
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      })();
    </script>
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="admin-top">
      <div class="container admin-top__inner">
        <a class="admin-top__brand" href="/admin" aria-label="Panel de TelMoney">
          <Logo size={30} />
          <span class="admin-top__tag">Panel</span>
        </a>
        {
          admin && (
            <nav class="admin-nav" aria-label="Secciones del panel">
              {nav.map((n) => (
                <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>
                  {n.label}
                </a>
              ))}
            </nav>
          )
        }
        <div class="admin-top__who">
          {admin && <span>{admin.email}</span>}
          <ThemeToggle />
          {
            admin && (
              <form method="post" action="/admin/salir">
                <button class="btn-quiet" type="submit">
                  Salir
                </button>
              </form>
            )
          }
        </div>
      </div>
    </header>
    <main id="main" class="admin-main container">
      <slot />
    </main>

    <div class="tip" role="tooltip" hidden data-tip-box></div>
    <script>
      // Un solo tooltip para todas las gráficas: lo que diga data-tip (primera línea en negrita).
      // Va con el puntero y también con el teclado (foco). Texto con textContent: nunca HTML.
      const box = document.querySelector<HTMLElement>('[data-tip-box]')!;
      const show = (el: Element, x: number, y: number) => {
        const [value, ...rest] = (el.getAttribute('data-tip') ?? '').split('\n');
        const strong = document.createElement('strong');
        strong.textContent = value;
        box.replaceChildren(strong, document.createTextNode(rest.join(' · ')));
        box.style.left = `${x}px`;
        box.style.top = `${y}px`;
        box.hidden = false;
      };
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element).closest?.('[data-tip]');
        if (el) show(el, e.clientX, e.clientY);
        else box.hidden = true;
      });
      document.addEventListener('focusin', (e) => {
        const el = (e.target as Element).closest?.('[data-tip]');
        if (!el) return void (box.hidden = true);
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener('focusout', () => (box.hidden = true));
      document.addEventListener('scroll', () => (box.hidden = true), { passive: true });
    </script>
  </body>
</html>
