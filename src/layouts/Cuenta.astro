---
// Marco de "Mi cuenta" (/cuenta): el otro medio para usar TelMoney, además de WhatsApp. Barra lateral
// con los módulos (al estilo del sidebar de shadcn/ui); en el celular se abre como un panel desde la
// izquierda. Usa los estilos del panel (admin.css) para tarjetas y tablas, y cuenta.css para el marco.
// Fuera de Google y sin caché (lo pone src/middleware.ts).
import '../styles/global.css';
import '../styles/admin.css';
import '../styles/cuenta.css';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/cuenta/Icon.astro';
import { WHATSAPP_NUMBER } from '../config';
import { esAdmin } from '../lib/admin/clerk';
import { NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, PUBLIC_CLERK_PUBLISHABLE_KEY } from 'astro:env/server';

export type Seccion =
  | 'resumen'
  | 'movimientos'
  | 'calendario'
  | 'ingresos'
  | 'apartados'
  | 'cuentas'
  | 'deudas'
  | 'metas'
  | 'presupuesto'
  | 'fijos'
  | 'reportes'
  | 'correo'
  | 'ajustes'
  | 'plan';

interface Props {
  title: string;
  section?: Seccion;
  /** Sin menú (ej. mientras conecta su WhatsApp). */
  bare?: boolean;
}
const { title, section, bare = false } = Astro.props;
// Para que el navegador renueve la sesión (script de abajo). La llave publicable no es secreta.
const clerkKey = PUBLIC_CLERK_PUBLISHABLE_KEY || NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY || '';

type Item = { id: Seccion; label: string; href: string; icon: Parameters<typeof Icon>[0]['name'] };
const groups: { label: string; items: Item[] }[] = [
  {
    label: 'General',
    items: [
      { id: 'resumen', label: 'Inicio', href: '/cuenta', icon: 'inicio' },
      { id: 'movimientos', label: 'Movimientos', href: '/cuenta/movimientos', icon: 'movimientos' },
      { id: 'calendario', label: 'Calendario', href: '/cuenta/calendario', icon: 'calendario' },
    ],
  },
  {
    label: 'Tu dinero',
    items: [
      { id: 'ingresos', label: 'Ingresos', href: '/cuenta/ingresos', icon: 'ingresos' },
      { id: 'apartados', label: 'Apartados (%)', href: '/cuenta/apartados', icon: 'apartados' },
      { id: 'cuentas', label: 'Cuentas y tarjetas', href: '/cuenta/cuentas', icon: 'cuentas' },
      { id: 'deudas', label: 'Deudas', href: '/cuenta/deudas', icon: 'deudas' },
      { id: 'metas', label: 'Metas', href: '/cuenta/metas', icon: 'metas' },
      { id: 'presupuesto', label: 'Presupuesto', href: '/cuenta/presupuesto', icon: 'presupuesto' },
      { id: 'fijos', label: 'Gastos fijos', href: '/cuenta/fijos', icon: 'fijos' },
    ],
  },
  {
    label: 'Herramientas',
    items: [
      { id: 'reportes', label: 'Reportes', href: '/cuenta/reportes', icon: 'reportes' },
      { id: 'correo', label: 'Correo del banco', href: '/cuenta/correo', icon: 'correo' },
      { id: 'ajustes', label: 'Ajustes', href: '/cuenta/ajustes', icon: 'ajustes' },
      { id: 'plan', label: 'Mi plan', href: '/cuenta/plan', icon: 'plan' },
    ],
  },
];
const current = groups.flatMap((g) => g.items).find((i) => i.id === section);
const waHref = WHATSAPP_NUMBER ? `https://wa.me/${WHATSAPP_NUMBER}` : null;
// Si la persona también es del equipo, un enlace al panel de administración.
const equipo = !bare && Astro.locals.cuenta ? await esAdmin(Astro.locals.cuenta.userId) : false;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <title>{`${title} · TelMoney`}</title>
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('tm-theme');
        } catch (e) {}
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      })();
    </script>
  </head>
  <body class:list={['admin', 'app', { 'app--bare': bare }]} data-clerk-key={clerkKey}>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    {
      !bare && (
        <aside class="sb" id="sb" aria-label="Menú de tu cuenta" data-sb>
          <div class="sb__head">
            <a class="sb__brand" href="/" aria-label="TelMoney, inicio">
              <Logo size={28} />
            </a>
            <button class="sb__close" type="button" aria-label="Cerrar menú" data-sb-close>
              <Icon name="cerrar" />
            </button>
          </div>

          {waHref && (
            <a class="sb__cta" href={waHref} target="_blank" rel="noopener">
              <Icon name="mensaje" />
              Anotar por WhatsApp
            </a>
          )}

          <nav class="sb__nav">
            {groups.map((g) => (
              <div class="sb__group">
                <p class="sb__label">{g.label}</p>
                <ul role="list">
                  {g.items.map((n) => (
                    <li>
                      <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>
                        <Icon name={n.icon} />
                        <span>{n.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>

          {equipo && (
            <a class="sb__admin" href="/admin">
              <Icon name="puntaje" />
              Panel de admin
            </a>
          )}

          <div class="sb__foot">
            <ThemeToggle />
            <form method="post" action="/cuenta/salir">
              <button class="sb__out" type="submit">
                <Icon name="salir" />
                Salir
              </button>
            </form>
          </div>
        </aside>
      )
    }
    {!bare && <div class="sb-scrim" data-sb-close hidden />}

    <div class="app__body">
      <header class="app-top">
        {
          !bare ? (
            <button class="app-top__menu" type="button" aria-label="Abrir menú" aria-controls="sb" aria-expanded="false" data-sb-open>
              <Icon name="menu" size={20} />
            </button>
          ) : (
            <a class="sb__brand" href="/" aria-label="TelMoney, inicio">
              <Logo size={28} />
            </a>
          )
        }
        <p class="app-top__title">{current?.label ?? title}</p>
        {
          bare && (
            <div class="app-top__end">
              <ThemeToggle />
              <form method="post" action="/cuenta/salir">
                <button class="btn-quiet" type="submit">
                  Salir
                </button>
              </form>
            </div>
          )
        }
      </header>
      <main id="main" class="app-main">
        <slot />
      </main>
    </div>

    <div class="tip" role="tooltip" hidden data-tip-box></div>
    <script>
      // Menú en el celular: se abre desde la izquierda, se cierra con la X, tocando fuera o con Escape.
      const sb = document.querySelector<HTMLElement>('[data-sb]');
      const scrim = document.querySelector<HTMLElement>('.sb-scrim');
      const opener = document.querySelector<HTMLButtonElement>('[data-sb-open]');
      const setOpen = (open: boolean) => {
        if (!sb || !scrim || !opener) return;
        sb.classList.toggle('is-open', open);
        scrim.hidden = !open;
        opener.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('sb-locked', open);
        if (open) sb.querySelector<HTMLElement>('[aria-current="page"], a')?.focus();
        else opener.focus();
      };
      opener?.addEventListener('click', () => setOpen(true));
      document.querySelectorAll('[data-sb-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sb?.classList.contains('is-open')) setOpen(false);
      });

      // Ventanas de edición (components/cuenta/Dialog.astro): se abren con [data-dialog], se llenan con
      // data-values y se cierran con [data-close], tocando fuera o con Escape (lo hace <dialog> solo).
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const opener = t.closest<HTMLElement>('[data-dialog]');
        if (opener) {
          const dlg = document.getElementById(opener.dataset.dialog!) as HTMLDialogElement | null;
          const form = dlg?.querySelector('form');
          if (!dlg || !form) return;
          form.reset();
          // reset() no limpia los campos ocultos que se cambiaron por código: el id y la acción, a mano.
          form.querySelectorAll<HTMLInputElement>('input[type=hidden]').forEach((h) => (h.value = h.dataset.default ?? ''));
          dlg.querySelector<HTMLElement>('[data-confirm]')?.setAttribute('hidden', '');
          const values = JSON.parse(opener.dataset.values ?? '{}') as Record<string, unknown>;
          for (const [k, v] of Object.entries(values)) {
            const el = form.elements.namedItem(k);
            // Varias casillas con el mismo nombre (p. ej. los días de la semana): se marcan las del arreglo.
            if (el instanceof RadioNodeList) {
              const vals = (Array.isArray(v) ? v : [v]).map(String);
              el.forEach((n) => n instanceof HTMLInputElement && (n.checked = vals.includes(n.value)));
            } else if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = Boolean(v);
            else if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement)
              el.value = v == null ? '' : String(v);
          }
          // Los campos marcados con data-solo-nuevo / data-solo-editar se muestran según haya id o no.
          const editando = Boolean(values.id);
          form.querySelectorAll<HTMLElement>('[data-solo-nuevo]').forEach((x) => (x.hidden = editando));
          form.querySelectorAll<HTMLElement>('[data-solo-editar]').forEach((x) => (x.hidden = !editando));
          const title = dlg.querySelector('[data-dlg-title]');
          if (title && opener.dataset.title) title.textContent = opener.dataset.title;
          const accion = form.querySelector<HTMLInputElement>('input[type=hidden][name=accion]');
          if (accion && opener.dataset.accion) accion.value = opener.dataset.accion;
          if (title && !opener.dataset.title) title.textContent = title.getAttribute('data-default') ?? title.textContent;
          dlg.showModal();
          form.querySelector<HTMLElement>('input:not([type=hidden]):not([hidden]), select, textarea')?.focus();
          return;
        }
        if (t.closest('[data-close]')) return void t.closest('dialog')?.close();
        if (t.closest('[data-ask]')) return void t.closest('form')?.querySelector('[data-confirm]')?.removeAttribute('hidden');
        if (t instanceof HTMLDialogElement) t.close(); // tocar el fondo
      });
      // La sesión de Clerk (cookie __session) dura un minuto. Al abrir una página el servidor la renueva
      // con una redirección, pero al mandar un formulario (POST) no puede: si la persona tardó más de un
      // minuto en llenarlo, llegaba «sin sesión» y se iba a /entrar sin guardar. Por eso aquí se carga
      // Clerk (sin su interfaz), que la mantiene al día, y antes de mandar cada formulario se renueva.
      type ClerkSesion = { load(): Promise<void>; session?: { getToken(o?: { skipCache?: boolean }): Promise<string | null> } | null };
      const clerkKey = document.body.dataset.clerkKey ?? '';
      const clerkListo: Promise<ClerkSesion | null> = clerkKey
        ? import('@clerk/shared/loadClerkJsScript')
            .then(({ loadClerkJSScript }) => loadClerkJSScript({ publishableKey: clerkKey }))
            .then(async () => {
              const c = (window as unknown as { Clerk: ClerkSesion }).Clerk;
              await c.load();
              return c;
            })
            .catch(() => null)
        : Promise.resolve(null);
      const renovar = async () => {
        const espera = new Promise<null>((r) => setTimeout(() => r(null), 5000));
        try {
          const c = await Promise.race([clerkListo, espera]);
          await Promise.race([c?.session?.getToken({ skipCache: true }), espera]);
        } catch {}
      };
      const renovados = new WeakSet<HTMLFormElement>();
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement;
        const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
        if (form.method.toLowerCase() !== 'post') return; // los filtros (GET) no lo necesitan
        if (renovados.has(form)) {
          // Ya con la sesión al día: se manda, y el botón no se puede volver a tocar.
          renovados.delete(form);
          if (btn) setTimeout(() => (btn.disabled = true));
          return;
        }
        e.preventDefault();
        if (form.dataset.enviando) return;
        form.dataset.enviando = '1';
        btn?.setAttribute('aria-busy', 'true');
        void renovar().then(() => {
          delete form.dataset.enviando;
          renovados.add(form);
          // requestSubmit con el mismo botón: así va su `accion` (p. ej. «Sí, borrar»).
          form.requestSubmit(btn && btn.form === form ? btn : undefined);
        });
      });

      // Tooltip de las gráficas (igual que en el panel): primera línea en negrita, texto con textContent.
      const box = document.querySelector<HTMLElement>('[data-tip-box]')!;
      const show = (el: Element, x: number, y: number) => {
        const [value, ...rest] = (el.getAttribute('data-tip') ?? '').split('\n');
        const strong = document.createElement('strong');
        strong.textContent = value;
        box.replaceChildren(strong, document.createTextNode(rest.join(' · ')));
        box.style.left = `${x}px`;
        box.style.top = `${y}px`;
        box.hidden = false;
      };
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element).closest?.('[data-tip]');
        if (el) show(el, e.clientX, e.clientY);
        else box.hidden = true;
      });
      document.addEventListener('focusin', (e) => {
        const el = (e.target as Element).closest?.('[data-tip]');
        if (!el) return void (box.hidden = true);
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener('focusout', () => (box.hidden = true));
      document.addEventListener('scroll', () => (box.hidden = true), { passive: true });
    </script>
  </body>
</html>
