---
// Marco de "Mi cuenta" (/cuenta): lo que cada persona ve de su TelMoney. Usa los estilos del panel
// (admin.css) con su propio menú. Fuera de Google y sin caché (lo pone src/middleware.ts).
import '../styles/global.css';
import '../styles/admin.css';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  section?: 'resumen' | 'movimientos' | 'correo' | 'plan';
  /** Sin menú (ej. mientras conecta su WhatsApp). */
  bare?: boolean;
}
const { title, section, bare = false } = Astro.props;

const nav = [
  { id: 'resumen', label: 'Resumen', href: '/cuenta' },
  { id: 'movimientos', label: 'Movimientos', href: '/cuenta/movimientos' },
  { id: 'correo', label: 'Correo', href: '/cuenta/correo' },
  { id: 'plan', label: 'Mi plan', href: '/cuenta/plan' },
] as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <title>{`${title} · TelMoney`}</title>
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('tm-theme');
        } catch (e) {}
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      })();
    </script>
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <header class="admin-top">
      <div class="container admin-top__inner">
        <a class="admin-top__brand" href="/" aria-label="TelMoney, inicio">
          <Logo size={30} />
        </a>
        {
          !bare ? (
            <nav class="admin-nav" aria-label="Mi cuenta">
              {nav.map((n) => (
                <a href={n.href} aria-current={section === n.id ? 'page' : undefined}>
                  {n.label}
                </a>
              ))}
            </nav>
          ) : (
            <span class="admin-nav" />
          )
        }
        <div class="admin-top__who">
          <ThemeToggle />
          <form method="post" action="/cuenta/salir">
            <button class="btn-quiet" type="submit">Salir</button>
          </form>
        </div>
      </div>
    </header>
    <main id="main" class="admin-main container">
      <slot />
    </main>

    <div class="tip" role="tooltip" hidden data-tip-box></div>
    <script>
      // Tooltip de las gráficas (igual que en el panel): primera línea en negrita, texto con textContent.
      const box = document.querySelector<HTMLElement>('[data-tip-box]')!;
      const show = (el: Element, x: number, y: number) => {
        const [value, ...rest] = (el.getAttribute('data-tip') ?? '').split('\n');
        const strong = document.createElement('strong');
        strong.textContent = value;
        box.replaceChildren(strong, document.createTextNode(rest.join(' · ')));
        box.style.left = `${x}px`;
        box.style.top = `${y}px`;
        box.hidden = false;
      };
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as Element).closest?.('[data-tip]');
        if (el) show(el, e.clientX, e.clientY);
        else box.hidden = true;
      });
      document.addEventListener('focusin', (e) => {
        const el = (e.target as Element).closest?.('[data-tip]');
        if (!el) return void (box.hidden = true);
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      document.addEventListener('focusout', () => (box.hidden = true));
      document.addEventListener('scroll', () => (box.hidden = true), { passive: true });
    </script>
  </body>
</html>
