---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import { SEO } from '../seo/meta';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={SEO.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />
    <SeoHead title={title} description={description} noindex={noindex} />

    <script is:inline>
      // Antes de pintar:
      // 1) el tema: lo que la persona eligió (localStorage) o, si no eligió, lo de su navegador;
      // 2) si acepta movimiento, ocultamos lo que GSAP va a revelar.
      (function () {
        var root = document.documentElement;
        var saved = null;
        try {
          saved = localStorage.getItem('tm-theme');
        } catch (e) {}
        var theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        root.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#ffffff' : '#000000');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('motion');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
    <Cursor />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
