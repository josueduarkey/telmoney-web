# Número oficial de WhatsApp en formato internacional, sin "+" (ej. 50370000000).
# Vacío = todavía no hay número: los botones llevan a la lista de espera de la beta.
PUBLIC_WHATSAPP_NUMBER=

# URL que recibe el formulario de la beta (POST JSON: name, whatsapp, email, pains, source, utm).
# Vacío = /api/waitlist de esta misma página, que guarda directo en la base (WAITLIST_DATABASE_URL).
PUBLIC_WAITLIST_URL=

# App de TelMoney (opcional). Google Play: URL de la ficha (vacío = búsqueda de «TelMoney»).
# App Store: vacío = se muestra «Muy pronto».
PUBLIC_PLAY_STORE_URL=
PUBLIC_APP_STORE_URL=

# Dominio público (sin «/» final): URLs absolutas para redes, sitemap y robots.txt.
PUBLIC_SITE_URL=https://telmoney.app
# Usuario de X sin «@» (opcional).
PUBLIC_X_HANDLE=

# ── Panel de administración (/admin) y formulario de la beta. Paso a paso: docs/admin.md ──
# Conexiones a la base del bot (Neon), cada una con su usuario de Postgres.
# panel_admin: solo lectura.
ADMIN_DATABASE_URL=
# landing_waitlist: solo la lista de espera (sin ella, en desarrollo el formulario es modo demo).
WAITLIST_DATABASE_URL=
# Clerk (inicio de sesión con Google)
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Correos con acceso al panel, separados por coma
ADMIN_EMAILS=josueduardo.dev@gmail.com
# Números del equipo (igual que en el bot): salen como «Invitado»
FREE_NUMBERS=
# Costo por mensaje en USD (opcional). Al migrar a la API de Meta directa: COST_TWILIO_PER_MESSAGE=0
# COST_TWILIO_PER_MESSAGE=0.005
# COST_META_PER_REPLY=0.0113
# COST_GEMINI_PER_MESSAGE=0.001
